---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Apex Content Lab | Marketing & Lead Generation Systems">
	<style>
		.hero { text-align: center; padding: 3rem 0; max-width: 850px; margin: 0 auto; }
		.hero-title { font-size: 2.75rem; font-weight: 800; line-height: 1.2; margin-bottom: 1rem; }
		.hero-sub { font-size: 1.15rem; color: var(--muted); margin-bottom: 2rem; }
		.btn-group { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

		.sec { margin: 4rem 0; }
		.sec-title { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
		.sec-desc { color: var(--muted); margin-bottom: 2rem; max-width: 650px; }

		.grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
		.grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 1.5rem; }
		
		.card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 0.75rem; padding: 2rem; transition: 0.2s; }
		.card:hover { border-color: var(--accent); }
		.card-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; }
		.card-text { color: var(--muted); font-size: 0.95rem; margin-bottom: 1rem; }

		.check-list { list-style: none; }
		.check-list li { font-size: 0.9rem; margin-bottom: 0.5rem; color: var(--text); }
		.check-list span { color: var(--accent); margin-right: 0.5rem; }

		.brand-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 1rem; padding: 2.5rem; display: grid; grid-template-columns: 200px 1fr; gap: 2.5rem; align-items: center; }
		.brand-logo-box { background: var(--bg-dark); border: 1px solid var(--border); padding: 1.5rem; border-radius: 0.75rem; display: flex; justify-content: center; align-items: center; }
		.brand-logo-box img { max-width: 100%; height: auto; max-height: 120px; object-fit: contain; }

		.pills { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
		.pill { background: rgba(255,255,255,0.05); border: 1px solid var(--border); padding: 0.25rem 0.6rem; border-radius: 0.375rem; font-size: 0.8rem; }

		@media (max-width: 768px) {
			.hero-title { font-size: 2rem; }
			.brand-card { grid-template-columns: 1fr; padding: 1.5rem; text-align: center; }
			.brand-logo-box { max-width: 200px; margin: 0 auto; }
		}
	</style>

	<!-- HERO -->
	<section class="hero">
		<span class="badge">Growth Systems Agency</span>
		<h1 class="hero-title">Turn Attention Into Qualified Leads. Build Marketing Systems That Scale.</h1>
		<p class="hero-sub">Apex Content Lab helps businesses attract, capture, nurture, and convert customers through automated email marketing, strategic content, and short-form video systems.</p>
		<div class="btn-group">
			<a href="#products" class="btn-primary">Download Free Blueprint</a>
			<a href="#services" class="btn-secondary">Explore Growth Systems</a>
		</div>
	</section>

	<!-- ABOUT -->
	<section id="about" class="sec">
		<div class="card" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
			<span class="badge">Marketing Without A System Costs You Customers</span>
			<h2 class="sec-title">We Replace Random Posting With Repeatable Growth</h2>
			<p class="sec-desc" style="max-width:100%;">Most businesses don't struggle because they lack content—they struggle because every campaign depends on starting from scratch. We build marketing systems that continue working long after content is published, creating structured channels that generate qualified leads consistently.</p>
		</div>
	</section>

	<!-- LEADERSHIP BRANDING -->
	<section id="leadership" class="sec">
		<span class="badge">Engineered by Strategy. Built for Growth.</span>
		<h2 class="sec-title">Leadership & Strategic Vision</h2>
		<div class="brand-card">
			<div class="brand-logo-box">
				<img src="/logo.png" alt="Apex Content Lab Brand Logo" />
			</div>
			<div>
				<h3 style="font-size: 1.5rem; font-weight: 700;">Ebua Hastings Etta</h3>
				<p style="color: var(--accent); font-weight: 600; font-size: 0.9rem; margin-bottom: 0.75rem;">Founder & Marketing Systems Strategist</p>
				<p style="color: var(--muted); font-size: 0.95rem; margin-bottom: 0.75rem;">Apex Content Lab was founded by Ebua Hastings Etta to help businesses convert attention into measurable sales pipelines through email automation, lead generation, and short-form video strategies.</p>
				<blockquote style="border-left: 2px solid var(--accent); padding-left: 1rem; color: var(--text); font-style: italic; font-size: 0.9rem; margin: 1rem 0;">"Successful marketing isn't about posting more content—it's about building systems that consistently create opportunities."</blockquote>
				<div class="pills">
					<span class="pill">Email Marketing</span>
					<span class="pill">Lead Generation</span>
					<span class="pill">Automation</span>
					<span class="pill">Content Strategy</span>
					<span class="pill">Short-Form Video</span>
				</div>
			</div>
		</div>
	</section>

	<!-- SERVICES -->
	<section id="services" class="sec">
		<span class="badge">Agency Services</span>
		<h2 class="sec-title">Core Growth Systems</h2>
		<p class="sec-desc">End-to-end agency services engineered for conversion and scalability.</p>
		<div class="grid-3">
			<div class="card">
				<h3 class="card-title">Email Marketing Systems</h3>
				<p class="card-text">Nurture leads and convert subscribers into clients automatically.</p>
				<ul class="check-list">
					<li><span>✓</span> Welcome Sequences & Newsletters</li>
					<li><span>✓</span> Campaign Strategy & Copywriting</li>
					<li><span>✓</span> Customer Retention Workflows</li>
				</ul>
			</div>
			<div class="card">
				<h3 class="card-title">Lead Generation Systems</h3>
				<p class="card-text">Turn cold traffic into qualified lead opportunities.</p>
				<ul class="check-list">
					<li><span>✓</span> Lead Magnet Strategy & Pages</li>
					<li><span>✓</span> Audience & Market Research</li>
					<li><span>✓</span> High-Converting Funnels</li>
				</ul>
			</div>
			<div class="card">
				<h3 class="card-title">Short-Form Video Strategy</h3>
				<p class="card-text">Attract audiences across modern platforms to feed backend systems.</p>
				<ul class="check-list">
					<li><span>✓</span> IG Reels, TikTok, YT Shorts & FB Reels</li>
					<li><span>✓</span> Content Repurposing Calendars</li>
					<li><span>✓</span> Programmatic Content Pipelines</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- PRODUCTS -->
	<section id="products" class="sec">
		<span class="badge">Resources & Toolkits</span>
		<h2 class="sec-title">Digital Products & Frameworks</h2>
		<p class="sec-desc">Practical assets to implement lead generation systems right away.</p>
		<div class="grid-2">
			<div class="card" style="border-color: rgba(56,189,248,0.4);">
				<span class="badge">Free Resource</span>
				<h3 class="card-title">Attention-to-Leads Blueprint</h3>
				<p class="card-text">Learn the exact framework for turning content attention into leads.</p>
				<a href="https://gumroad.com" target="_blank" class="btn-primary" style="width:100%;">Download Free Blueprint</a>
			</div>
			<div class="card">
				<span class="badge" style="color:#a855f7; border-color:rgba(168,85,247,0.3); background:rgba(168,85,247,0.1);">Premium Kit (Gumroad)</span>
				<h3 class="card-title">Lead Magnet Blueprint Kit</h3>
				<p class="card-text">Comprehensive toolkit for building high-converting lead magnets.</p>
				<ul class="check-list" style="margin-bottom:1rem;">
					<li><span>✓</span> 118-Page Blueprint Guide</li>
					<li><span>✓</span> Worksheets & Frameworks</li>
					<li><span>✓</span> Implementation Checklists</li>
				</ul>
				<a href="https://gumroad.com" target="_blank" class="btn-secondary" style="width:100%;">View Product on Gumroad</a>
			</div>
		</div>
	</section>

	<!-- FRAMEWORK -->
	<section id="framework" class="sec">
		<div class="card" style="text-align:center; padding:3rem 1.5rem;">
			<span class="badge">The Growth Engine</span>
			<h2 class="sec-title">The Attention-to-Leads System</h2>
			<div style="display:flex; justify-content:center; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; font-weight:700;">
				<span class="card" style="padding:0.75rem 1.25rem;">Attention</span> →
				<span class="card" style="padding:0.75rem 1.25rem;">Lead Capture</span> →
				<span class="card" style="padding:0.75rem 1.25rem;">Lead Nurture</span> →
				<span class="card" style="padding:0.75rem 1.25rem; border-color:var(--primary);">Conversion</span>
			</div>
		</div>
	</section>

	<!-- FINAL CTA -->
	<section class="sec" style="text-align:center; background:var(--bg-card); border:1px solid var(--border); padding:3rem 1.5rem; border-radius:1rem;">
		<h2 class="sec-title">Ready to Build a Marketing System That Works?</h2>
		<p class="sec-desc" style="margin:0 auto 1.5rem;">Download the free Attention-to-Leads Blueprint or explore our premium resources today.</p>
		<div class="btn-group">
			<a href="#products" class="btn-primary">Get the Free Blueprint</a>
			<a href="https://linkedin.com" target="_blank" class="btn-secondary">Connect on LinkedIn</a>
		</div>
	</section>
</Layout>
