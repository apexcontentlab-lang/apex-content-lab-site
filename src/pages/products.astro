---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import ProductCard from '../components/cards/ProductCard.astro';
import { productsData } from '../data/products';

const paidProducts = productsData.filter(
  (product) => product.price.amount > 0
);
---

<BaseLayout
  title="Premium Growth Blueprints & Digital Products | Apex Content Lab"
  description="Explore premium growth blueprints and practical implementation resources from Apex Content Lab for businesses building stronger lead generation, marketing infrastructure, email systems, and customer journeys."
>
  <Header />

  <main class="flex-grow">

    <!-- Header Hero -->
    <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/50 via-white to-white py-16 lg:py-24 border-b border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="text-center max-w-3xl mx-auto space-y-5">

          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
            <span>Premium Resources</span>
            <span class="text-blue-300">•</span>
            <span>Practical Growth Assets</span>
          </div>

          <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
            Premium Growth
            <span class="text-[var(--color-apex-blue,#2563EB)]">
              Blueprints & Systems
            </span>
          </h1>

          <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto">
            Practical, implementation-focused resources designed to help businesses solve specific marketing problems, build stronger lead generation systems, and turn attention into business opportunities.
          </p>

          <div class="pt-3 flex flex-wrap items-center justify-center gap-3 text-sm text-gray-500">
            <span>Lead Generation</span>
            <span class="text-gray-300">•</span>
            <span>Lead Magnets</span>
            <span class="text-gray-300">•</span>
            <span>Email Marketing</span>
            <span class="text-gray-300">•</span>
            <span>Growth Systems</span>
          </div>

        </div>
      </div>
    </section>


    <!-- Premium Products -->
    <section class="py-16 lg:py-24 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        {paidProducts.length > 0 ? (

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">

            {paidProducts.map((product) => (
              <ProductCard product={product} />
            ))}

          </div>

        ) : (

          <div class="rounded-3xl border border-gray-200 bg-gray-50 px-6 py-16 text-center">

            <h2 class="text-xl font-bold text-gray-900">
              Premium Products Coming Soon
            </h2>

            <p class="mt-2 max-w-xl mx-auto text-sm text-gray-600 leading-relaxed">
              We're preparing practical premium resources to help businesses build stronger lead generation, marketing infrastructure, and customer acquisition systems.
            </p>

          </div>

        )}

      </div>
    </section>


    <!-- What These Products Are For -->
    <section class="py-20 lg:py-24 bg-gray-50 border-y border-gray-100">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

        <div class="max-w-3xl mx-auto text-center space-y-4">

          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
            Built for Implementation
          </span>

          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
            These are not just information products.
          </h2>

          <p class="text-base text-gray-600 leading-relaxed">
            Each premium resource is designed around a specific business problem and gives you a practical framework for understanding what needs to be built, why it matters, and how the pieces fit together.
          </p>

        </div>


        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">

          <div class="rounded-2xl bg-white border border-gray-200 p-7">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400">
              01
            </span>

            <h3 class="mt-3 text-lg font-bold text-gray-900">
              Understand the Problem
            </h3>

            <p class="mt-2 text-sm text-gray-600 leading-relaxed">
              Identify the gap between your current marketing activity and the system required to turn attention into measurable opportunities.
            </p>
          </div>


          <div class="rounded-2xl bg-white border border-gray-200 p-7">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400">
              02
            </span>

            <h3 class="mt-3 text-lg font-bold text-gray-900">
              Build the Right Asset
            </h3>

            <p class="mt-2 text-sm text-gray-600 leading-relaxed">
              Use practical frameworks to create lead magnets, capture pathways, and other assets that support the customer journey.
            </p>
          </div>


          <div class="rounded-2xl bg-white border border-gray-200 p-7">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400">
              03
            </span>

            <h3 class="mt-3 text-lg font-bold text-gray-900">
              Connect the System
            </h3>

            <p class="mt-2 text-sm text-gray-600 leading-relaxed">
              Understand how the asset connects with content, email marketing, automation, and the wider growth system.
            </p>
          </div>

        </div>
      </div>
    </section>


    <!-- Free vs Premium -->
    <section class="py-20 lg:py-24 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

        <div class="rounded-3xl border border-gray-200 bg-gray-50 p-8 sm:p-10">

          <div class="text-center space-y-4">

            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
              Not Sure Where to Start?
            </span>

            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900">
              Start with the free Attention-to-Leads Blueprint.
            </h2>

            <p class="max-w-2xl mx-auto text-sm sm:text-base text-gray-600 leading-relaxed">
              If you're still figuring out how to turn content and social media attention into leads, start with our free Blueprint before exploring the premium resources.
            </p>

          </div>


          <div class="mt-7 flex flex-wrap justify-center gap-4">

            <a
              href="/resources"
              class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-6 py-3.5 text-sm font-semibold text-white shadow-md hover:bg-blue-700 transition-colors"
            >
              Explore Free Resources
            </a>

            <a
              href="/framework"
              class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-6 py-3.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
            >
              Explore the Framework
            </a>

          </div>

        </div>
      </div>
    </section>


    <!-- Product FAQ / Buyer Questions -->
    <section class="py-20 lg:py-24 bg-gray-50 border-y border-gray-100">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

        <div class="text-center max-w-3xl mx-auto space-y-4">

          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
            Premium Resource Questions
          </span>

          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
            Questions before buying a growth blueprint?
          </h2>

          <p class="text-base text-gray-600 leading-relaxed">
            Here's how our premium resources fit into the wider Apex Content Lab growth systems approach.
          </p>

        </div>


        <div class="mt-12 space-y-4">

          <details class="group rounded-2xl border border-gray-200 bg-white p-6">
            <summary class="cursor-pointer list-none font-bold text-gray-900 flex items-center justify-between gap-4">
              <span>Who are the premium resources for?</span>
              <span class="text-gray-400 group-open:rotate-180 transition-transform">
                ↓
              </span>
            </summary>

            <p class="mt-4 text-sm text-gray-600 leading-relaxed">
              They are designed for founders, service businesses, creators, consultants, and teams that want practical frameworks for improving lead generation, lead magnets, email marketing, and marketing infrastructure.
            </p>
          </details>


          <details class="group rounded-2xl border border-gray-200 bg-white p-6">
            <summary class="cursor-pointer list-none font-bold text-gray-900 flex items-center justify-between gap-4">
              <span>Are these products the same as the free resources?</span>
              <span class="text-gray-400 group-open:rotate-180 transition-transform">
                ↓
              </span>
            </summary>

            <p class="mt-4 text-sm text-gray-600 leading-relaxed">
              No. The free resources provide accessible educational starting points. The premium resources go further into specific problems and provide more structured implementation guidance.
            </p>
          </details>


          <details class="group rounded-2xl border border-gray-200 bg-white p-6">
            <summary class="cursor-pointer list-none font-bold text-gray-900 flex items-center justify-between gap-4">
              <span>How do the premium resources fit into a growth system?</span>
              <span class="text-gray-400 group-open:rotate-180 transition-transform">
                ↓
              </span>
            </summary>

            <p class="mt-4 text-sm text-gray-600 leading-relaxed">
              They help you solve individual parts of the wider customer journey. For example, a lead magnet framework can support lead capture, which can then connect to email nurture and the broader marketing infrastructure.
            </p>
          </details>


          <details class="group rounded-2xl border border-gray-200 bg-white p-6">
            <summary class="cursor-pointer list-none font-bold text-gray-900 flex items-center justify-between gap-4">
              <span>Do I need the premium resources to work with Apex Content Lab?</span>
              <span class="text-gray-400 group-open:rotate-180 transition-transform">
                ↓
              </span>
            </summary>

            <p class="mt-4 text-sm text-gray-600 leading-relaxed">
              No. The products are designed to be useful as standalone resources. Businesses that need help implementing a complete system can also explore Apex Content Lab's professional services.
            </p>
          </details>

        </div>


        <div class="mt-10 text-center">

          <p class="text-sm text-gray-500">
            Looking for more answers?
            <a
              href="/faqs/growth-systems-faq"
              class="font-medium text-[var(--color-apex-blue,#2563EB)] underline hover:no-underline"
            >
              Visit the Growth Systems FAQ
            </a>
          </p>

        </div>

      </div>
    </section>


    <!-- Services Connection -->
    <section class="py-20 lg:py-24 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

        <div class="rounded-3xl bg-gray-900 text-white p-8 sm:p-12 text-center">

          <span class="text-xs font-bold uppercase tracking-wider text-blue-400">
            Need Implementation Help?
          </span>

          <h2 class="mt-3 text-2xl sm:text-3xl font-bold">
            A blueprint is useful. A working system is better.
          </h2>

          <p class="mt-4 max-w-2xl mx-auto text-sm sm:text-base text-gray-300 leading-relaxed">
            If you know what needs to be built but don't want to handle the implementation alone, explore our services for lead generation, lead magnets, email marketing infrastructure, and growth systems.
          </p>

          <div class="mt-7 flex flex-wrap justify-center gap-4">

            <a
              href="/services/lead-magnet-launchpad"
              class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-6 py-3.5 text-sm font-semibold text-white hover:bg-blue-700 transition-colors"
            >
              Lead Magnet Launchpad
            </a>

            <a
              href="/services/email-marketing-infrastructure"
              class="inline-flex items-center justify-center rounded-xl border border-gray-600 px-6 py-3.5 text-sm font-medium text-gray-200 hover:bg-gray-800 transition-colors"
            >
              Email Marketing Infrastructure
            </a>

          </div>

        </div>
      </div>
    </section>

  </main>

  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
