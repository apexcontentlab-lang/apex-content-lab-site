---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site';
import { servicesData, processSteps } from '../data/services';
---

<BaseLayout
  title="Growth Systems & Services"
  description="Explore Apex Content Lab's modular growth systems—engineered to turn online attention into lead generation and customer acquisition."
>
  <Header />

  <main class="flex-grow">
    <!-- Header Hero -->
    <section class="bg-gradient-to-b from-blue-50/50 via-white to-white py-16 lg:py-24 border-b border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
            <span>Modular Implementations</span>
          </div>
          <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
            Engineered Marketing Infrastructure
          </h1>
          <p class="text-lg text-gray-600 leading-relaxed">
            Choose a tailored growth system built around your current business maturity and lead generation goals.
          </p>
        </div>
      </div>
    </section>

    <!-- Services Detailed Breakdown -->
    <section class="py-16 lg:py-24 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-20">
        {servicesData.map((service, index) => (
          <div 
            id={service.id}
            class={`scroll-mt-28 rounded-3xl p-8 sm:p-12 border ${
              service.isFlagship 
                ? 'border-[var(--color-apex-blue,#2563EB)] bg-gradient-to-br from-blue-50/30 via-white to-white ring-1 ring-blue-500/20 shadow-xl' 
                : 'border-gray-200 bg-white shadow-sm'
            }`}
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
              
              <!-- Left Column: Strategy Info -->
              <div class="lg:col-span-5 space-y-6">
                <div class="flex items-center gap-3">
                  <span class={`px-3 py-1 rounded-full text-xs font-semibold ${service.accentColor.bg} ${service.accentColor.text}`}>
                    {service.badge}
                  </span>
                  {service.isFlagship && (
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-600 text-white">
                      Recommended
                    </span>
                  )}
                </div>

                <h2 class="text-3xl font-extrabold text-gray-900">{service.title}</h2>
                <p class="text-base font-medium text-[var(--color-apex-blue,#2563EB)]">{service.purpose}</p>
                <p class="text-sm text-gray-600 leading-relaxed">{service.summary}</p>

                <div class="pt-4">
                  <a
                    href={service.cta.href}
                    class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-6 py-3.5 text-sm font-semibold text-white shadow-md hover:bg-blue-700 transition-colors focus-ring"
                  >
                    {service.cta.text}
                  </a>
                </div>
              </div>

              <!-- Right Column: Key Deliverables -->
              <div class="lg:col-span-7 bg-gray-50/80 rounded-2xl p-6 sm:p-8 border border-gray-100">
                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-6">
                  What's Included in This System
                </h3>

                <div class="space-y-6">
                  {service.deliverables.map((deliverable) => (
                    <div class="flex items-start gap-4">
                      <div class="rounded-lg bg-blue-100 p-2 text-[var(--color-apex-blue,#2563EB)] shrink-0 mt-0.5">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                      </div>
                      <div>
                        <h4 class="text-sm font-bold text-gray-900">{deliverable.title}</h4>
                        <p class="text-xs text-gray-600 mt-0.5 leading-relaxed">{deliverable.description}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Methodology -->
    <section class="py-16 bg-gray-50 border-t border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
          <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">Implementation Process</h2>
          <p class="text-sm text-gray-600">How we turn requirements into live operating assets.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {processSteps.map((step) => (
            <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
              <span class="text-2xl font-black text-[var(--color-apex-blue,#2563EB)]">{step.number}</span>
              <h3 class="text-base font-bold text-gray-900 mt-2 mb-1">{step.title}</h3>
              <p class="text-xs text-gray-600 leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
