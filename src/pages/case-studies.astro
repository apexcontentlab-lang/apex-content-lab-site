---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site';

const pageTitle = "Case Studies & Systems Proof | Apex Content Lab";
const pageDescription = "Explore selected work, marketing infrastructure systems, products, and documented projects behind the Apex Content Lab growth systems methodology.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/40 via-white to-white py-20 lg:py-28">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-6 text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
          <span>Systems & Implementation Proof</span>
          <span class="text-blue-300">•</span>
          <span>Verified Architecture</span>
        </div>

        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl leading-[1.15]">
          Case Studies & <span class="text-[var(--color-apex-blue,#2563EB)]">Proof</span>
        </h1>

        <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
          Apex Content Lab doesn't just talk about growth systems. We build the assets, marketing infrastructure, and digital architecture that turn online attention into predictable business growth.
        </p>

        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a
            href={siteConfig.routes.bookCall}
            class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-blue-700 transition-colors"
          >
            Book Strategy Call
          </a>

          <a
            href="/framework"
            class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-8 py-4 text-base font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition-colors"
          >
            Explore Our Framework
          </a>
        </div>
      </div>
    </section>

    <!-- Proof Philosophy Section -->
    <section class="py-16 bg-white border-b border-gray-100">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-8">
        <div class="max-w-2xl space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">
            Our Approach to Proof & Credibility
          </h2>

          <p class="text-gray-600 leading-relaxed text-sm sm:text-base">
            In modern marketing, "proof" is frequently diluted by unverified metrics, fabricated testimonials, and hollow revenue claims. At Apex Content Lab, we believe true credibility comes from tangible engineering: the systems built, the assets deployed, and the operational clarity provided to a business.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-gray-50 border border-gray-200 space-y-3">
            <h3 class="font-bold text-gray-900 text-base">
              1. Systems Built
            </h3>

            <p class="text-xs sm:text-sm text-gray-600">
              Permanent infrastructure designed to capture attention and automate prospect nurturing without manual friction.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-gray-50 border border-gray-200 space-y-3">
            <h3 class="font-bold text-gray-900 text-base">
              2. Assets Created
            </h3>

            <p class="text-xs sm:text-sm text-gray-600">
              High-utility digital products, frameworks, and lead magnet blueprints engineered for conversion.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-gray-50 border border-gray-200 space-y-3">
            <h3 class="font-bold text-gray-900 text-base">
              3. Documented Work
            </h3>

            <p class="text-xs sm:text-sm text-gray-600">
              Transparent methodologies, public frameworks, and operational architectures built for longevity.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Work / Systems & Projects Section -->
    <section class="py-20 bg-gray-50">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-12">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          <h2 class="text-3xl font-bold text-gray-900 tracking-tight">
            Selected Systems & Projects
          </h2>

          <p class="text-gray-600 text-sm sm:text-base">
            A breakdown of verified infrastructure, resources, and implementation architectures built and maintained by Apex Content Lab.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

          <!-- Card 1: Marketing Infrastructure & Framework -->
          <div class="rounded-2xl bg-white border border-gray-200 p-8 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
                <span>Core Framework</span>
              </div>

              <h3 class="text-xl font-bold text-gray-900">
                Marketing Infrastructure Architecture
              </h3>

              <p class="text-sm text-gray-600 leading-relaxed">
                A 4-phase implementation model designed to transition businesses away from transient ad campaigns and manual outreach toward permanent operational growth systems.
              </p>

              <div class="space-y-2 pt-2 text-xs text-gray-500">
                <p>
                  <strong>What was built:</strong>
                  Complete audit, architecture, infrastructure build, and automated integration pathways.
                </p>

                <p>
                  <strong>Why it matters:</strong>
                  Replaces fragile monthly retainers with compounding, owned infrastructure.
                </p>
              </div>
            </div>

            <div class="pt-6 mt-6 border-t border-gray-100 flex items-center justify-between">
              <span class="text-xs font-semibold text-gray-400">
                System Architecture
              </span>

              <a
                href="/framework"
                class="text-sm font-semibold text-[var(--color-apex-blue,#2563EB)] hover:underline"
              >
                Explore Framework →
              </a>
            </div>
          </div>

          <!-- Card 2: Lead Magnet Launchpad Service -->
          <div class="rounded-2xl bg-white border border-gray-200 p-8 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
                <span>Professional Service</span>
              </div>

              <h3 class="text-xl font-bold text-gray-900">
                Lead Magnet Launchpad System
              </h3>

              <p class="text-sm text-gray-600 leading-relaxed">
                A structured professional service that researches audience pain points, designs high-value lead magnets, and connects them directly to functional opt-in funnels.
              </p>

              <div class="space-y-2 pt-2 text-xs text-gray-500">
                <p>
                  <strong>What was built:</strong>
                  Research methodologies, opt-in capture flows, and immediate asset delivery mechanisms.
                </p>

                <p>
                  <strong>Why it matters:</strong>
                  Converts casual website visitors into owned email subscribers systematically.
                </p>
              </div>
            </div>

            <div class="pt-6 mt-6 border-t border-gray-100 flex items-center justify-between">
              <span class="text-xs font-semibold text-gray-400">
                Implementation Service
              </span>

              <a
                href="/services/lead-magnet-launchpad"
                class="text-sm font-semibold text-[var(--color-apex-blue,#2563EB)] hover:underline"
              >
                View Service →
              </a>
            </div>
          </div>

          <!-- Card 3: Email Marketing Infrastructure Service -->
          <div class="rounded-2xl bg-white border border-gray-200 p-8 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
                <span>Automation Service</span>
              </div>

              <h3 class="text-xl font-bold text-gray-900">
                Email Nurture & Follow-Up Infrastructure
              </h3>

              <p class="text-sm text-gray-600 leading-relaxed">
                Automated email architectures engineered to eliminate manual follow-up delays and nurture prospects through multi-step value sequences.
              </p>

              <div class="space-y-2 pt-2 text-xs text-gray-500">
                <p>
                  <strong>What was built:</strong>
                  Behavioral segmentation, welcome workflows, and conversion trigger pathways.
                </p>

                <p>
                  <strong>Why it matters:</strong>
                  Ensures no subscriber falls through cracks while protecting against algorithm shifts.
                </p>
              </div>
            </div>

            <div class="pt-6 mt-6 border-t border-gray-100 flex items-center justify-between">
              <span class="text-xs font-semibold text-gray-400">
                Conversion Architecture
              </span>

              <a
                href="/services/email-marketing-infrastructure"
                class="text-sm font-semibold text-[var(--color-apex-blue,#2563EB)] hover:underline"
              >
                View Service →
              </a>
            </div>
          </div>

          <!-- Card 4: Free Attention-to-Leads Blueprint Resource -->
          <div class="rounded-2xl bg-white border border-gray-200 p-8 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
                <span>Free Resource</span>
              </div>

              <h3 class="text-xl font-bold text-gray-900">
                Attention-to-Leads Blueprint
              </h3>

              <p class="text-sm text-gray-600 leading-relaxed">
                A public educational asset demonstrating the exact tactical journey required to convert transient social media attention into qualified B2B pipeline.
              </p>

              <div class="space-y-2 pt-2 text-xs text-gray-500">
                <p>
                  <strong>What was built:</strong>
                  Educational blueprint, opt-in mechanism, and automated delivery system.
                </p>

                <p>
                  <strong>Why it matters:</strong>
                  Serves as the primary educational entry point into the Apex Content Lab ecosystem.
                </p>
              </div>
            </div>

            <div class="pt-6 mt-6 border-t border-gray-100 flex items-center justify-between">
              <span class="text-xs font-semibold text-gray-400">
                Educational Asset
              </span>

              <a
                href="/resources"
                class="text-sm font-semibold text-[var(--color-apex-blue,#2563EB)] hover:underline"
              >
                Access Resource →
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Attention → Lead → Nurture → Conversion Methodology Section -->
    <section class="py-20 bg-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-10">
        <div class="text-center space-y-3">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">
            The Growth Systems Methodology in Practice
          </h2>

          <p class="text-gray-600 text-sm sm:text-base">
            Every piece of infrastructure we build is designed around a single connected pipeline progression:
          </p>
        </div>

        <div class="space-y-4 text-sm text-gray-700">

          <div class="p-5 rounded-xl border border-gray-200 bg-gray-50/50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
                Stage 1
              </span>

              <h3 class="font-bold text-gray-900 text-base">
                Attention & Visibility
              </h3>

              <p class="text-xs text-gray-600 mt-1">
                Targeted content and organic publishing attract qualified prospects.
              </p>
            </div>

            <span class="text-gray-400 font-bold text-lg">↓</span>
          </div>

          <div class="p-5 rounded-xl border border-gray-200 bg-gray-50/50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
                Stage 2
              </span>

              <h3 class="font-bold text-gray-900 text-base">
                Lead Capture
              </h3>

              <p class="text-xs text-gray-600 mt-1">
                High-value lead magnets convert casual visitors into owned subscribers.
              </p>
            </div>

            <span class="text-gray-400 font-bold text-lg">↓</span>
          </div>

          <div class="p-5 rounded-xl border border-gray-200 bg-gray-50/50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
                Stage 3
              </span>

              <h3 class="font-bold text-gray-900 text-base">
                Email Nurture
              </h3>

              <p class="text-xs text-gray-600 mt-1">
                Automated sequences build trust and handle consistent follow-up.
              </p>
            </div>

            <span class="text-gray-400 font-bold text-lg">↓</span>
          </div>

          <div class="p-5 rounded-xl border border-gray-200 bg-gray-50/50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
                Stage 4
              </span>

              <h3 class="font-bold text-gray-900 text-base">
                Conversion & Growth
              </h3>

              <p class="text-xs text-gray-600 mt-1">
                Qualified prospects transition into strategy calls and business pipeline.
              </p>
            </div>
          </div>

        </div>

        <div class="pt-4 text-center">
          <p class="text-xs text-gray-500">
            Have questions about how this infrastructure applies to your business?
            Visit our
            <a
              href="/faqs/growth-systems-faq"
              class="text-[var(--color-apex-blue,#2563EB)] underline font-medium"
            >
              Growth Systems FAQ Hub
            </a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Bottom CTA Section -->
    <section class="py-16 bg-gray-900 text-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center space-y-6">
        <h2 class="text-3xl font-extrabold tracking-tight">
          Ready to Engineer Your Marketing Infrastructure?
        </h2>

        <p class="text-gray-300 text-base max-w-xl mx-auto">
          Move away from random marketing activities. Let's build a predictable growth system tailored to your business model.
        </p>

        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a
            href={siteConfig.routes.bookCall}
            class="rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-blue-600 transition-colors"
          >
            Book Strategy Call
          </a>

          <a
            href="/framework"
            class="rounded-xl bg-gray-800 border border-gray-700 px-8 py-4 text-base font-medium text-white hover:bg-gray-700 transition-colors"
          >
            Explore the Framework
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
