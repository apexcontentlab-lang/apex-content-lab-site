<form action="YOUR_MAILERLITE_FORM_URL_HERE" method="POST" style="display: flex; flex-direction: column; gap: 1.2rem;">
	<div>
		<label style="display: block; margin-bottom: 0.5rem; font-size: 0.9rem; color: #f8fafc;" for="name">First Name</label>
		<input type="text" name="fields[name]" required placeholder="Enter your name" style="width: 100%; padding: 0.85rem; border-radius: 0.5rem; border: 1px solid #475569; background: #0f172a; color: white;" />
	</div>
	<div>
		<label style="display: block; margin-bottom: 0.5rem; font-size: 0.9rem; color: #f8fafc;" for="email">Email Address</label>
		<input type="email" name="fields[email]" required placeholder="Enter your best email" style="width: 100%; padding: 0.85rem; border-radius: 0.5rem; border: 1px solid #475569; background: #0f172a; color: white;" />
	</div>
	<button type="submit" class="btn" style="margin-top: 0.5rem; width: 100%; border: none; cursor: pointer; font-size: 1rem;">Download Free Blueprint (PDF)</button>
</form>
