---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Free Blueprint | Apex Content Lab">
	<div style="max-width: 650px; margin: 0 auto; padding: 1rem 0;">
		<div style="text-align: center; margin-bottom: 2rem;">
			<span style="background-color: rgba(56, 189, 248, 0.1); color: #38bdf8; padding: 0.35rem 0.85rem; border-radius: 1rem; font-size: 0.85rem; font-weight: 600;">FREE MARKETING SYSTEM GUIDE</span>
			<h1 style="font-size: 2.25rem; color: #f8fafc; margin: 1rem 0 0.5rem 0;">Attention-to-Leads Blueprint</h1>
			<p style="color: #94a3b8; font-size: 1.05rem;">
				Stop starting from scratch every time you post. Learn the simple framework for turning content attention into qualified leads and compounding growth.
			</p>
		</div>

		<div style="background-color: #1e293b; padding: 2rem; border-radius: 0.75rem; border: 1px solid #334155;">
			<h2 style="font-size: 1.25rem; color: #38bdf8; margin-bottom: 1.5rem; text-align: center;">Get Instant Access</h2>
			<form style="display: flex; flex-direction: column; gap: 1.2rem;" onsubmit="event.preventDefault(); alert('Blueprint download link sent!');">
				<div>
					<label style="display: block; margin-bottom: 0.5rem; font-size: 0.9rem; color: #f8fafc;" for="name">First Name</label>
					<input type="text" id="name" required placeholder="Enter your name" style="width: 100%; padding: 0.85rem; border-radius: 0.5rem; border: 1px solid #475569; background: #0f172a; color: white;" />
				</div>
				<div>
					<label style="display: block; margin-bottom: 0.5rem; font-size: 0.9rem; color: #f8fafc;" for="email">Email Address</label>
					<input type="email" id="email" required placeholder="Enter your best email" style="width: 100%; padding: 0.85rem; border-radius: 0.5rem; border: 1px solid #475569; background: #0f172a; color: white;" />
				</div>
				<button type="submit" class="btn" style="margin-top: 0.5rem; width: 100%; border: none; cursor: pointer; font-size: 1rem;">Download Free Blueprint (PDF)</button>
			</form>
		</div>
	</div>
</Layout>
