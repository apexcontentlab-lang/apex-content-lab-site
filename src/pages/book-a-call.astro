---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site';

const callHighlights = [
  'Review your current customer-acquisition journey',
  'Identify the highest-impact growth-system bottleneck',
  'Determine whether Apex should diagnose, build, optimize, consult, or train',
  'Define the likely scope, requirements, and next step',
];
---

<BaseLayout
  title={`Diagnose Your Growth System | ${siteConfig.name}`}
  description="Start a growth-system conversation with Apex Content Lab. Review your customer journey, identify the bottleneck, and determine the appropriate next intervention."
  keywords={['growth strategy call', 'growth systems consultation', 'customer acquisition audit', 'Apex Content Lab']}
>
  <Header />

  <main id="main-content" class="flex-grow">
    <section class="bg-gradient-to-b from-blue-50/50 via-white to-white py-12 lg:py-16 border-b border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto space-y-3">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
            <span>Growth System Diagnostic</span>
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
            Diagnose Your Growth System
          </h1>

          <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
            Start with the business problem. We identify the constraint before recommending a build.
          </p>
        </div>
      </div>
    </section>

    <section class="py-12 lg:py-20 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

          <div class="lg:col-span-5 space-y-8">
            <div class="space-y-4">
              <h2 class="text-2xl font-bold text-gray-900">
                What happens next?
              </h2>

              <p class="text-sm text-gray-600 leading-relaxed">
                This focused conversation with founder Ebua Hastings Etta is used to understand your current acquisition system, identify the most important constraint, and determine the appropriate next step.
              </p>
            </div>

            <div class="space-y-4">
              {callHighlights.map((highlight) => (
                <div class="flex items-start gap-3">
                  <div class="rounded-lg bg-blue-100 p-1.5 text-[var(--color-apex-blue,#2563EB)] shrink-0 mt-0.5">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </div>

                  <p class="text-sm font-medium text-gray-700 leading-snug">
                    {highlight}
                  </p>
                </div>
              ))}
            </div>

            <div class="rounded-2xl bg-gray-50 p-6 border border-gray-200 space-y-3">
              <h3 class="text-sm font-bold text-gray-900">
                Prefer direct contact?
              </h3>

              <p class="text-xs text-gray-600 leading-relaxed">
                You can contact Apex directly by email or WhatsApp if you are not ready to schedule.
              </p>

              <div class="flex flex-wrap gap-4">
                <a
                  href={`mailto:${siteConfig.contact.primaryEmail}`}
                  class="text-xs font-semibold text-[var(--color-apex-blue,#2563EB)] hover:underline"
                >
                  Email Apex
                </a>

                <a
                  href={siteConfig.contact.whatsapp.fullUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold text-green-700 hover:underline"
                >
                  Message on WhatsApp
                </a>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7 rounded-3xl border border-gray-200 bg-white p-4 sm:p-8 shadow-md">
            <div class="min-h-[430px] w-full flex flex-col items-center justify-center rounded-2xl bg-gray-50 border border-dashed border-gray-300 p-6 text-center">

              <div class="max-w-md space-y-4">

                <div class="mx-auto w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-[var(--color-apex-blue,#2563EB)]">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    />
                  </svg>
                </div>

                <h2 class="text-lg font-bold text-gray-900">
                  Book a Strategic Call
                </h2>

                <p class="text-sm text-gray-600 leading-relaxed">
                  Choose a time that works for you and schedule your growth-system conversation with Apex Content Lab.
                </p>

                <a
                  href={siteConfig.integrations.calendly.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-6 py-3 text-sm font-semibold text-white shadow hover:bg-blue-700 transition-colors focus-ring"
                >
                  Book Strategic Call
                </a>

              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
