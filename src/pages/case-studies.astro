---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site';

const pageTitle = 'Work & Proof | Apex Content Lab';
const pageDescription = 'Explore the frameworks, systems, digital assets, and documented work that demonstrate how Apex Content Lab approaches growth-system design and implementation.';
const work = [
  { type: 'Core Framework', title: 'The Apex Growth System', description: 'A seven-stage customer-acquisition model connecting Attract, Capture, Onboard, Nurture, Segment, Convert, and Optimize.', href: '/framework', cta: 'Explore Framework' },
  { type: 'Professional System', title: 'Attention-to-Leads Growth System', description: 'The flagship architecture connecting content and distribution to capture, CRM, nurture, sales handoff, conversion, reporting, and optimization.', href: '/services/attention-to-leads-growth-system', cta: 'View Service' },
  { type: 'Free Resource', title: 'Attention-to-Leads Blueprint', description: 'A public educational resource explaining the journey from attention to lead capture and follow-up.', href: '/resources', cta: 'View Resource' },
  { type: 'Digital Products', title: 'Growth System Resource Library', description: 'Practical blueprints, templates, worksheets, checklists, and implementation resources for businesses building parts of their acquisition system.', href: '/products', cta: 'View Products' },
];
---
<BaseLayout title={pageTitle} description={pageDescription} keywords={['Apex Content Lab work','growth systems examples','customer acquisition systems','growth system proof']}>
  <Header />
  <main id="main-content" class="flex-grow">
    <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/40 via-white to-white py-20 lg:py-28">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-6 text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">Work, Frameworks & Proof</span>
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">Show the work. <span class="text-[var(--color-apex-blue,#2563EB)]">Document the system.</span></h1>
        <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">This library distinguishes documented Apex work from verified client results. We do not publish invented testimonials or unsupported performance claims.</p>
        <a href={siteConfig.routes.bookCall} class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-blue-700">Discuss a Growth System</a>
      </div>
    </section>

    <section class="py-16 bg-white border-b border-gray-100">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="rounded-2xl bg-gray-50 border border-gray-200 p-6"><h2 class="font-bold text-gray-900">Documented Work</h2><p class="mt-2 text-sm text-gray-600">Frameworks, resources, products, and system architectures that can be inspected directly.</p></div>
          <div class="rounded-2xl bg-gray-50 border border-gray-200 p-6"><h2 class="font-bold text-gray-900">Verified Results</h2><p class="mt-2 text-sm text-gray-600">Client outcomes should be published only when they can be attributed and substantiated.</p></div>
          <div class="rounded-2xl bg-gray-50 border border-gray-200 p-6"><h2 class="font-bold text-gray-900">Transparent Claims</h2><p class="mt-2 text-sm text-gray-600">The site separates what Apex has built, what it recommends, and what has been independently measured.</p></div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-gray-50">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto space-y-3"><h2 class="text-3xl font-bold text-gray-900">Selected systems and assets</h2><p class="text-gray-600">Use these resources to understand the operating logic before engaging Apex.</p></div>
        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">
          {work.map((item) => <article class="rounded-2xl bg-white border border-gray-200 p-8 shadow-sm flex flex-col justify-between"><div><span class="inline-flex rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">{item.type}</span><h3 class="mt-4 text-xl font-bold text-gray-900">{item.title}</h3><p class="mt-3 text-sm text-gray-600 leading-relaxed">{item.description}</p></div><a href={item.href} class="mt-7 text-sm font-semibold text-[var(--color-apex-blue,#2563EB)] hover:underline">{item.cta} →</a></article>)}
        </div>
      </div>
    </section>

    <section class="py-20 bg-white text-center"><div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-5"><h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Looking for client-specific evidence?</h2><p class="text-gray-600">As verified client engagements accumulate, this section can expand into documented case studies with baseline, intervention, measured outcome, and lessons learned.</p><a href={siteConfig.routes.contact} class="inline-flex items-center justify-center rounded-xl bg-gray-900 px-8 py-3.5 text-sm font-semibold text-white hover:bg-gray-800">Contact Apex</a></div></section>
  </main>
  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
