---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Apex Content Lab | Growth Systems & Digital Marketing Agency">
	<style>
		.hero { text-align: center; padding: 3.5rem 0 4.5rem; max-width: 900px; margin: 0 auto; }
		.hero-title { font-size: 3rem; font-weight: 800; line-height: 1.15; margin-bottom: 1.25rem; letter-spacing: -0.02em; }
		.hero-sub { font-size: 1.2rem; color: var(--muted); margin-bottom: 2.25rem; max-width: 780px; margin-left: auto; margin-right: auto; }
		.btn-group { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

		.sec { margin: 5.5rem 0; }
		.sec-title { font-size: 2.15rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.01em; }
		.sec-desc { color: var(--muted); margin-bottom: 2.25rem; max-width: 700px; font-size: 1.05rem; }

		.grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.75rem; }
		.grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 1.75rem; }

		.card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 0.75rem; padding: 2.25rem; transition: all 0.25s ease; }
		.card:hover { border-color: var(--accent); transform: translateY(-2px); }
		.card-title { font-size: 1.3rem; font-weight: 700; margin-bottom: 0.65rem; color: var(--text); }
		.card-text { color: var(--muted); font-size: 0.975rem; margin-bottom: 1.25rem; }

		.mockup-img { width: 100%; height: auto; border-radius: 0.5rem; margin-bottom: 1.25rem; border: 1px solid var(--border); object-fit: cover; }

		.check-list { list-style: none; margin-bottom: 1.25rem; }
		.check-list li { font-size: 0.925rem; margin-bottom: 0.5rem; color: var(--text); display: flex; align-items: center; gap: 0.6rem; }
		
		/* Custom Professional SVG Checkmark */
		.check-icon { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; border-radius: 50%; background: rgba(56, 189, 248, 0.15); color: var(--accent); flex-shrink: 0; }
		.check-icon svg { width: 11px; height: 11px; stroke: currentColor; stroke-width: 3; fill: none; }

		/* Founder Card */
		.founder-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 1rem; padding: 3rem; display: grid; grid-template-columns: 220px 1fr; gap: 2.5rem; align-items: center; }
		.brand-logo-box { background: var(--bg-dark); border: 1px solid var(--border); padding: 1.75rem; border-radius: 0.75rem; display: flex; justify-content: center; align-items: center; }
		.brand-logo-box img { max-width: 100%; height: auto; max-height: 140px; object-fit: contain; }

		.pills { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
		.pill { background: rgba(255,255,255,0.04); border: 1px solid var(--border); padding: 0.4rem 0.85rem; border-radius: 0.375rem; font-size: 0.85rem; color: var(--text); font-weight: 500; }

		/* Downward Framework Diagram with Vector Arrows */
		.framework-container { max-width: 500px; margin: 2rem auto 0; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
		.framework-step { background: var(--bg-dark); border: 1px solid var(--border); width: 100%; text-align: center; padding: 1rem 1.5rem; border-radius: 0.5rem; font-weight: 700; font-size: 1.1rem; color: var(--text); }
		.framework-arrow-svg { color: var(--accent); width: 20px; height: 20px; margin: 0.25rem 0; }

		@media (max-width: 800px) {
			.hero-title { font-size: 2.15rem; }
			.founder-card { grid-template-columns: 1fr; padding: 1.75rem; text-align: left; }
			.brand-logo-box { max-width: 220px; margin: 0 auto; }
			.grid-2 { grid-template-columns: 1fr; }
		}
	</style>

	<!-- 1. HERO SECTION -->
	<section class="hero">
		<span class="badge">Growth Systems Agency</span>
		<h1 class="hero-title">Turn Attention Into Qualified Leads. Build Marketing Systems That Grow Your Business.</h1>
		<p class="hero-sub">
			Apex Content Lab helps businesses attract, capture, nurture, and convert customers through email marketing, lead generation, strategic content, marketing automation, and short-form video systems.
		</p>
		<div class="btn-group">
			<a href="https://preview.mailerlite.io/preview/2453071/forms/190605752159700691" target="_blank" rel="noopener noreferrer" class="btn-primary">Download Free Blueprint</a>
