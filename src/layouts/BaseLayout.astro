---
import SEOHead from '../components/seo/SEOHead.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
  noindex?: boolean;
  imageAlt?: string;
  keywords?: string[];
  dateModified?: string;
}

const {
  title,
  description,
  image,
  canonicalURL,
  type,
  noindex,
  imageAlt,
  keywords,
  dateModified,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
      type={type}
      noindex={noindex}
      imageAlt={imageAlt}
      keywords={keywords}
      dateModified={dateModified}
    />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HJ0KXGMN8X"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-HJ0KXGMN8X');
    </script>

  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
      <slot />
  </body>
</html>
