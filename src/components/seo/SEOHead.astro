---
import { siteConfig } from '../../config/site';
import { entityIds, masterGraphSchema } from '../../schemas/masterSchema';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
  noindex?: boolean;
  imageAlt?: string;
  keywords?: string[];
  dateModified?: string;
}

const {
  title = siteConfig.seo.defaultTitle,
  description = siteConfig.seo.defaultDescription,
  image = siteConfig.seo.ogImage,
  canonicalURL = new URL(Astro.url.pathname, siteConfig.url).href,
  type = 'website',
  noindex = false,
  imageAlt = `${siteConfig.name} — Growth Systems Company`,
  keywords = [],
  dateModified,
} = Astro.props;

const formattedTitle = title.includes(siteConfig.name)
  ? title
  : siteConfig.seo.titleTemplate.replace('%s', title);

const fullImageUrl = image.startsWith('http') ? image : `${siteConfig.url}${image}`;
const webpageId = `${canonicalURL}#webpage`;

const webpageEntity = {
  '@type': 'WebPage',
  '@id': webpageId,
  url: canonicalURL,
  name: formattedTitle,
  description,
  isPartOf: { '@id': entityIds.website },
  about: { '@id': entityIds.organization },
  publisher: { '@id': entityIds.organization },
  inLanguage: 'en',
  ...(dateModified ? { dateModified } : {}),
};

const pageGraph = { '@context': 'https://schema.org', '@graph': [...masterGraphSchema['@graph'], webpageEntity] };
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content={siteConfig.seo.themeColor} />
<meta name="author" content={siteConfig.founder.name} />
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
<link rel="alternate icon" href="/favicon/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={siteConfig.seo.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Geographic context: useful supporting metadata, not a substitute for visible location information. -->
<meta name="geo.region" content={siteConfig.geo.region} />
<meta name="geo.placename" content={siteConfig.geo.placename} />
<meta name="geo.position" content={siteConfig.geo.position} />
<meta name="ICBM" content={siteConfig.geo.ICBM} />

<script type="application/ld+json" set:html={JSON.stringify(pageGraph)} />
