---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Free Blueprint | Apex Content Lab">
	<h1 style="font-size: 2rem; color: #38bdf8; margin-bottom: 1rem;">Attention to Leads Blueprint</h1>
	<p style="color: #94a3b8; margin-bottom: 2rem;">Learn the step-by-step framework to plan and produce short-form content systematically.</p>
	<div style="background: #1e293b; padding: 1.5rem; border-radius: 0.75rem; border: 1px solid #334155;">
		<p style="color: white; margin-bottom: 1rem;">Enter your email to receive instant access:</p>
		<input type="email" placeholder="Your Email Address" style="width: 100%; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #475569; background: #0f172a; color: white; margin-bottom: 1rem;" />
		<button class="btn" style="width: 100%; border: none; cursor: pointer;">Get Instant Access</button>
	</div>
</Layout>
