---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site';

const callHighlights = [
  "Audit your current audience touchpoints & lead capture rate",
  "Identify leaks in your lead nurture and email conversion funnel",
  "Map out a tailored closed-loop growth system architecture",
  "Define clear technical requirements & implementation timeline"
];
---

<BaseLayout
  title={`Book a Strategy Call | ${siteConfig.name}`}
  description="Schedule a 1-on-1 strategy session with Apex Content Lab founder Ebua Hastings Etta to architect your custom marketing growth system."
>
  <Header />

  <main class="flex-grow">
    <!-- Header Hero -->
    <section class="bg-gradient-to-b from-blue-50/50 via-white to-white py-12 lg:py-16 border-b border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto space-y-3">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
            <span>1-on-1 Discovery Session</span>
          </div>
          <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
            Schedule Your Growth Strategy Call
          </h1>
          <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
            Let's design a permanent marketing system tailored to your business goals.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Content Area: Information + Embed -->
    <section class="py-12 lg:py-20 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          
          <!-- Left Column: Expectations & Context -->
          <div class="lg:col-span-5 space-y-8">
            <div class="space-y-4">
              <h2 class="text-2xl font-bold text-gray-900">What We Cover On This Call</h2>
              <p class="text-sm text-gray-600 leading-relaxed">
                This is a focused session with founder Ebua Hastings Etta to review your current lead generation flow and evaluate if an Apex Growth System is the right fit.
              </p>
            </div>

            <!-- Call Agenda Highlights -->
            <div class="space-y-4">
              {callHighlights.map((highlight) => (
                <div class="flex items-start gap-3">
                  <div class="rounded-lg bg-blue-100 p-1.5 text-[var(--color-apex-blue,#2563EB)] shrink-0 mt-0.5">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <p class="text-sm font-medium text-gray-700 leading-snug">{highlight}</p>
                </div>
              ))}
            </div>

            <!-- Direct Contact Alternative -->
            <div class="rounded-2xl bg-gray-50 p-6 border border-gray-200 space-y-3">
              <h3 class="text-sm font-bold text-gray-900">Need a faster answer?</h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                If you have a quick technical question or immediate project deadline, reach out on WhatsApp directly for a quick response.
              </p>
              <a
                href={`https://wa.me/${siteConfig.contact.whatsapp.number.replace('+', '')}?text=${encodeURIComponent(siteConfig.contact.whatsapp.defaultMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-xs font-semibold text-[#25D366] hover:underline gap-1"
              >
                Message on WhatsApp
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Right Column: Calendar Booking Widget / Container -->
          <div class="lg:col-span-7 rounded-3xl border border-gray-200 bg-white p-4 sm:p-8 shadow-md">
            <div class="min-h-[550px] w-full flex flex-col items-center justify-center rounded-2xl bg-gray-50 border border-dashed border-gray-300 p-6 text-center">
              
              <!-- Placeholder for External Calendar Embed (Cal.com / Google Calendar / TidyCal) -->
              <div class="max-w-md space-y-4">
                <div class="mx-auto w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-[var(--color-apex-blue,#2563EB)]">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <h3 class="text-lg font-bold text-gray-900">Calendar Integration Ready</h3>
                <p class="text-xs text-gray-600 leading-relaxed">
                  Connect your preferred scheduling link (Cal.com, Calendly, or TidyCal embed script) here.
                </p>
                
                <a
                  href={`mailto:${siteConfig.contact.primaryEmail}?subject=Strategy%20Call%20Booking%20Request`}
                  class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-6 py-3 text-xs font-semibold text-white shadow hover:bg-blue-700 transition-colors focus-ring"
                >
                  Request Appointment via Email
                </a>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

<!-- existing Book Strategic Call / Calendly content -->

<Footer />
<FloatingWhatsApp />
</BaseLayout>
