---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import FloatingWhatsApp from '../../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../../config/site';

const pageTitle = "Growth Systems & Marketing Infrastructure FAQ | Apex Content Lab";
const pageDescription = "Get clear answers about growth systems, marketing infrastructure, lead generation, lead magnets, email automation, and how Apex Content Lab helps businesses build structured growth systems.";

const sources = {
  googleSenderGuidelines: "https://support.google.com/mail/answer/81126",
  googleSenderIssues: "https://support.google.com/mail/answer/15256272",
  googlePostmasterTools: "https://support.google.com/mail/answer/14289100",
  googleHelpfulContent: "https://developers.google.com/search/docs/fundamentals/creating-helpful-content",
  googleAiSearch: "https://developers.google.com/search/docs/fundamentals/ai-optimization-guide",
  icoElectronicMarketing: "https://ico.org.uk/for-organisations/direct-marketing-and-privacy-and-electronic-communications/guidance-on-direct-marketing-using-electronic-mail/"
};

const sourceReferences = [
  {
    id: "google-sender-guidelines",
    name: "Google Email Sender Guidelines",
    url: sources.googleSenderGuidelines,
    publisher: "Google",
    description: "Google's guidance for email senders, including sender requirements and email delivery practices."
  },
  {
    id: "google-sender-issues",
    name: "Google Sender Issues and Requirements",
    url: sources.googleSenderIssues,
    publisher: "Google",
    description: "Google's guidance for senders experiencing delivery and compliance issues."
  },
  {
    id: "google-postmaster-tools",
    name: "Google Postmaster Tools",
    url: sources.googlePostmasterTools,
    publisher: "Google",
    description: "Google's sender-data and email-delivery monitoring resource."
  },
  {
    id: "google-helpful-content",
    name: "Creating Helpful, Reliable, People-First Content",
    url: sources.googleHelpfulContent,
    publisher: "Google Search Central",
    description: "Google's guidance on creating useful, reliable content for people."
  },
  {
    id: "google-ai-search",
    name: "AI Features and Your Website",
    url: sources.googleAiSearch,
    publisher: "Google Search Central",
    description: "Google's guidance concerning website content and AI-powered search experiences."
  },
  {
    id: "ico-electronic-marketing",
    name: "Direct Marketing Using Electronic Mail",
    url: sources.icoElectronicMarketing,
    publisher: "Information Commissioner's Office",
    description: "Regulatory guidance concerning direct marketing by electronic mail."
  }
];

const faqSourceIds = {
  emailDelivery: [
    "google-sender-guidelines",
    "google-sender-issues",
    "google-postmaster-tools"
  ],
  helpfulContent: [
    "google-helpful-content",
    "google-ai-search"
  ],
  emailMarketingCompliance: [
    "ico-electronic-marketing"
  ]
};

const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": `${siteConfig.url}/faqs/growth-systems-faq`,
  "isPartOf": {
    "@type": "WebSite",
    "name": siteConfig.name,
    "url": siteConfig.url
  },
  "about": {
    "@type": "Thing",
    "name": "Growth systems and marketing infrastructure"
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.name,
    "url": siteConfig.url
  }
};

const sourceCollectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Growth Systems & Marketing Infrastructure Sources",
  "url": `${siteConfig.url}/faqs/growth-systems-faq`,
  "about": [
    {
      "@type": "Thing",
      "name": "Growth systems"
    },
    {
      "@type": "Thing",
      "name": "Marketing infrastructure"
    },
    {
      "@type": "Thing",
      "name": "Lead generation"
    },
    {
      "@type": "Thing",
      "name": "Email marketing"
    },
    {
      "@type": "Thing",
      "name": "Marketing automation"
    }
  ],
  "hasPart": sourceReferences.map((source) => ({
    "@type": "CreativeWork",
    "@id": `${siteConfig.url}/faqs/growth-systems-faq#${source.id}`,
    "name": source.name,
    "url": source.url,
    "publisher": {
      "@type": "Organization",
      "name": source.publisher
    },
    "description": source.description
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <Header />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqPageSchema)}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(sourceCollectionSchema)}
  />

  <main class="flex-grow">

    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/40 via-white to-white py-20 lg:py-28">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-6 text-center">

        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
          <span>Knowledge Hub</span>
          <span class="text-blue-300">•</span>
          <span>Growth Systems & SEO/GEO FAQ</span>
        </div>

        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl leading-[1.15]">
          Growth Systems & Marketing
          <span class="text-[var(--color-apex-blue,#2563EB)]">Infrastructure FAQ</span>
        </h1>

        <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
          Comprehensive, standalone answers regarding growth systems, marketing infrastructure, lead generation, email automation, and the Apex Content Lab methodology.
        </p>

        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a
            href={siteConfig.routes.bookCall}
            class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-blue-700 transition-colors"
          >
            Book Strategy Call
          </a>

          <a
            href="/framework"
            class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-8 py-4 text-base font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition-colors"
          >
            Explore Our Framework
          </a>
        </div>

      </div>
    </section>


    <!-- Table of Contents / Quick Navigation -->
    <section class="py-8 bg-gray-50 border-y border-gray-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-4">

        <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500 text-center sm:text-left">
          Quick Navigation — Table of Contents
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-sm">

          <a
            href="#growth-systems"
            class="p-3 rounded-xl bg-white border border-gray-200 hover:border-[var(--color-apex-blue,#2563EB)] hover:text-[var(--color-apex-blue,#2563EB)] font-medium transition-colors flex items-center justify-between"
          >
            <span>1. Growth Systems</span>
            <span class="text-gray-400 text-xs">→</span>
          </a>

          <a
            href="#marketing-infrastructure"
            class="p-3 rounded-xl bg-white border border-gray-200 hover:border-[var(--color-apex-blue,#2563EB)] hover:text-[var(--color-apex-blue,#2563EB)] font-medium transition-colors flex items-center justify-between"
          >
            <span>2. Infrastructure</span>
            <span class="text-gray-400 text-xs">→</span>
          </a>

          <a
            href="#lead-generation"
            class="p-3 rounded-xl bg-white border border-gray-200 hover:border-[var(--color-apex-blue,#2563EB)] hover:text-[var(--color-apex-blue,#2563EB)] font-medium transition-colors flex items-center justify-between"
          >
            <span>3. Lead Generation</span>
            <span class="text-gray-400 text-xs">→</span>
          </a>

          <a
            href="#lead-magnets"
            class="p-3 rounded-xl bg-white border border-gray-200 hover:border-[var(--color-apex-blue,#2563EB)] hover:text-[var(--color-apex-blue,#2563EB)] font-medium transition-colors flex items-center justify-between"
          >
            <span>4. Lead Magnets</span>
            <span class="text-gray-400 text-xs">→</span>
          </a>

          <a
            href="#email-marketing-infrastructure"
            class="p-3 rounded-xl bg-white border border-gray-200 hover:border-[var(--color-apex-blue,#2563EB)] hover:text-[var(--color-apex-blue,#2563EB)] font-medium transition-colors flex items-center justify-between"
          >
            <span>5. Email Systems</span>
            <span class="text-gray-400 text-xs">→</span>
          </a>

          <a
            href="#marketing-automation"
            class="p-3 rounded-xl bg-white border border-gray-200 hover:border-[var(--color-apex-blue,#2563EB)] hover:text-[var(--color-apex-blue,#2563EB)] font-medium transition-colors flex items-center justify-between"
          >
            <span>6. Automation</span>
            <span class="text-gray-400 text-xs">→</span>
          </a>

          <a
            href="#apex-content-lab"
            class="p-3 rounded-xl bg-white border border-gray-200 hover:border-[var(--color-apex-blue,#2563EB)] hover:text-[var(--color-apex-blue,#2563EB)] font-medium transition-colors flex items-center justify-between"
          >
            <span>7. Apex Content Lab</span>
            <span class="text-gray-400 text-xs">→</span>
          </a>

          <a
            href="#comparison-evaluation"
            class="p-3 rounded-xl bg-white border border-gray-200 hover:border-[var(--color-apex-blue,#2563EB)] hover:text-[var(--color-apex-blue,#2563EB)] font-medium transition-colors flex items-center justify-between"
          >
            <span>8. Comparison</span>
            <span class="text-gray-400 text-xs">→</span>
          </a>

        </div>
      </div>
    </section>


    <!-- Main Content Body -->
    <section class="py-16 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-16 text-gray-700 leading-relaxed">


        <!-- SECTION 1: GROWTH SYSTEMS -->
        <div id="growth-systems" class="space-y-8 pt-4">

          <h2 class="text-2xl sm:text-3xl font-bold text-gray-950 tracking-tight border-b pb-4">
            1. Growth Systems
          </h2>

          <div class="space-y-6 text-sm">

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What is a growth system?</h3>
              <p>
                A growth system is an integrated operational framework that connects audience research, positioning, lead capture, and automated follow-up to turn online attention into predictable business opportunities.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What does a growth system mean in marketing?</h3>
              <p>
                In marketing, a growth system represents a shift away from isolated tactical experiments toward a structured, repeatable engine where every component—from content to conversion—feeds directly into customer acquisition.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">Why do businesses need a growth system?</h3>
              <p>
                Businesses need a growth system to eliminate the volatility of random marketing activities. Without a system, attention evaporates; with a growth system, traffic is captured and systematically nurtured.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What is the difference between a growth system and a marketing strategy?</h3>
              <p>
                A marketing strategy defines your positioning, target audience, and messaging direction, whereas a growth system is the operational infrastructure that executes and automates that strategy day in and day out.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What is the difference between a growth system and a marketing campaign?</h3>
              <p>
                A marketing campaign is temporary, ending when ad spend or promotional cycles conclude. A growth system is permanent infrastructure designed to compound in value over time.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What is the difference between a growth system and a marketing agency?</h3>
              <p>
                A marketing agency typically sells recurring services or campaign execution, whereas a growth systems company like
                <a href="/about" class="text-blue-600 underline">Apex Content Lab</a>
                engineers permanent infrastructure into your business.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">How does a growth system turn attention into leads?</h3>
              <p>
                A growth system uses targeted content to attract attention, structured lead magnets to capture contact details, and automated email workflows to nurture prospects into qualified sales conversations.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What are the main components of a growth system?</h3>
              <p>
                The core components include audience positioning, visibility channels, lead capture mechanisms, automated email nurture sequences, CRM tracking, and conversion pathways.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">How long does it take to build a growth system?</h3>
              <p>
                Building a growth system involves auditing current workflows, designing architecture, and deploying capture and email infrastructure, typically structured across distinct implementation phases.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">Who needs a growth system?</h3>
              <p>
                B2B founders, service providers, and digital businesses that generate online attention or content but struggle to convert that traffic into predictable inbound leads need a growth system.
              </p>
            </div>

          </div>
        </div>


        <!-- SECTION 2: MARKETING INFRASTRUCTURE -->
        <div id="marketing-infrastructure" class="space-y-8 pt-4">

          <h2 class="text-2xl sm:text-3xl font-bold text-gray-950 tracking-tight border-b pb-4">
            2. Marketing Infrastructure
          </h2>

          <div class="space-y-6 text-sm">

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What is marketing infrastructure?</h3>
              <p>
                Marketing infrastructure is the permanent network of landing pages, capture forms, email sequences, and CRM workflows that support customer acquisition and follow-up.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What does marketing infrastructure include?</h3>
              <p>
                It includes research frameworks, positioning assets, lead magnets, opt-in funnels, email automation tools, and behavioral tracking mechanisms as detailed in our
                <a href="/framework/what-is-marketing-infrastructure" class="text-blue-600 underline">Infrastructure Guide</a>.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What is permanent marketing infrastructure?</h3>
              <p>
                Permanent marketing infrastructure refers to operational assets that remain active and valuable long after creation, contrasting sharply with transient advertising campaigns.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">How is marketing infrastructure different from advertising?</h3>
              <p>
                Advertising purchases temporary visibility on external platforms, whereas marketing infrastructure owns and manages the system that converts that visibility into leads.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">How is marketing infrastructure different from content marketing?</h3>
              <p>
                Content marketing creates the material that generates attention; marketing infrastructure provides the capture and conversion architecture that ensures that attention yields business value.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">How is marketing infrastructure different from marketing automation?</h3>
              <p>
                Marketing automation is the software layer executing tasks, whereas marketing infrastructure encompasses the broader strategic architecture and customer journey design.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">Why is marketing infrastructure important?</h3>
              <p>
                It prevents lead leakage, reduces manual follow-up friction, and establishes predictable scaling pathways independent of algorithmic fluctuations.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What happens when a business has marketing activity but no infrastructure?</h3>
              <p>
                The business experiences high traffic or content engagement with low conversion rates, forcing a constant treadmill of manual outreach and ad spend.
              </p>
            </div>
                             
            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">How does marketing infrastructure reduce dependence on social media?</h3>
              <p>
                By capturing social media traffic into owned email subscriber lists, marketing infrastructure insulates your business from sudden algorithm changes.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">How does marketing infrastructure support lead generation?</h3>
              <p>
                It provides structured opt-in pathways and automated follow-up sequences that systematically convert visitors into qualified prospects.
              </p>
            </div>

          </div>
        </div>


        <!-- SECTION 3: LEAD GENERATION -->
        <div id="lead-generation" class="space-y-8 pt-4">

          <h2 class="text-2xl sm:text-3xl font-bold text-gray-950 tracking-tight border-b pb-4">
            3. Lead Generation
          </h2>

          <div class="space-y-6 text-sm">

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What is lead generation?</h3>
              <p>
                Lead generation is the process of attracting and converting prospective buyers into interested contacts who have provided their information for ongoing communication.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">How does content generate leads?</h3>
              <p>
                Content captures attention and addresses specific audience pain points, directing interested readers toward a lead magnet and opt-in form.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">Why do businesses get attention but few leads?</h3>
              <p>
                They lack structured conversion pathways and clear lead magnets that give casual visitors a compelling reason to exchange their contact details.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">How does a lead magnet generate leads?</h3>
              <p>
                By offering immediate, high-value solutions to a specific problem in exchange for an email address, bridging anonymous traffic and owned subscriber relationships.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What is the difference between a follower, subscriber, lead and customer?</h3>
              <p>
                A follower views content on rented platform space; a subscriber has joined your owned email list; a lead has expressed specific commercial interest; a customer has completed a purchase.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">Why should businesses capture email addresses from website visitors?</h3>
              <p>
                Email addresses represent direct, owned communication channels with subscribers who have chosen to hear from the business, rather than relying entirely on third-party platform distribution.
              </p>

               <p class="text-xs text-gray-500 border-t border-gray-200 pt-3">
                For Gmail senders, Google recommends sending to recipients who explicitly opted in and respecting user choice.
                <a
                  href={sources.googleSenderIssues}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-600 underline"
                >
                  Google Gmail sender guidance
                </a>
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What is a lead capture funnel?</h3>
              <p>
                A lead capture funnel is the sequence of web pages, forms, and automated delivery mechanisms designed to acquire prospect contact data efficiently.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What should happen after someone becomes a lead?</h3>
              <p>
                They should immediately receive their requested resource followed by an automated nurture sequence that builds trust and guides them toward a discovery call or purchase.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">Why does follow-up matter in lead generation?</h3>
              <p>
                Most prospects do not buy on first contact; consistent, automated follow-up ensures your brand remains top-of-mind when purchasing intent peaks.
              </p>
            </div>

          </div>
        </div>


        <!-- SECTION 4: LEAD MAGNETS -->
        <div id="lead-magnets" class="space-y-8 pt-4">

          <h2 class="text-2xl sm:text-3xl font-bold text-gray-950 tracking-tight border-b pb-4">
            4. Lead Magnets
          </h2>

          <div class="space-y-6 text-sm">

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What is a lead magnet?</h3>
              <p>
                A lead magnet is a high-value, specific digital resource given away for free in exchange for contact information.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What makes a good lead magnet?</h3>
              <p>
                A strong lead magnet solves a single, urgent problem quickly, is easy to consume, and naturally aligns with your core paid offers.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">Why do some lead magnets fail to generate leads?</h3>
              <p>
                They often address vague topics or require excessive effort to consume without delivering immediate utility to the prospect.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">What should a lead magnet solve?</h3>
              <p>
                It should solve one specific, high-friction bottleneck that your target audience faces in their daily operations.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">How should a business choose a lead magnet topic?</h3>
              <p>
                By identifying the primary preliminary question or friction point prospects encounter immediately before needing your core service or product.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">Should a lead magnet be a PDF, checklist, template or guide?</h3>
              <p>
                The format should match the content: actionable templates, checklists, and concise playbooks can be easier for prospects to consume and apply than lengthy theoretical PDFs.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
              <h3 class="font-bold text-gray-900 text-base">How does a lead magnet connect to email marketing?</h3>
              <p>
                Submitting contact info for the lead magnet triggers an automated email delivery workflow that transitions the user into your ongoing nurture sequence.
              </p>
            </div>

            <div class="space-y-2 p-6 rounded-2xl bg-gray-50 border border-gray-200">
