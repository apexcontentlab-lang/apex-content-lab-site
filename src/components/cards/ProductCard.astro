---
import { siteConfig } from '../../config/site';
import type { DigitalProduct } from '../../data/products';
import {
  CheckCircle2,
  ExternalLink,
  ShoppingBag,
  BookOpen,
} from 'lucide-astro';

interface Props {
  product: DigitalProduct;
  class?: string;
}

const { product, class: className = '' } = Astro.props;

const hasProductImage = Boolean(product.coverImage);
const ctaUrl = product.gumroadUrl;
const isAvailable = Boolean(ctaUrl);

const ctaLabel =
  product.bundleCta ??
  (product.id === 'lead-magnet-blueprint'
    ? 'Get the Blueprint'
    : 'Get It on Gumroad');

const savingsPercent =
  product.id === 'welcome-email-system'
    ? '14.7%'
    : product.id === 'welcome-email-practical-resource-kit'
      ? '18.75%'
      : null;
---

<article
  class:list={[
    'relative h-full rounded-[var(--radius-card)] border bg-white p-8 flex flex-col justify-between transition-all duration-300 hover:shadow-[var(--shadow-apex-hover)] hover:-translate-y-1',
    product.isPopular
      ? 'border-2 border-[var(--color-apex-blue)] ring-4 ring-[var(--color-apex-blue-light)]'
      : 'border-[var(--color-border-gray)]',
    className,
  ]}
  itemscope
  itemtype="https://schema.org/Product"
>
  {product.isPopular && (
    <div class="absolute -top-3.5 right-8 rounded-full bg-[var(--color-apex-blue)] px-4 py-1 text-xs font-bold text-white uppercase tracking-wider shadow-md">
      {product.isBundle ? 'Best Value' : 'Most Popular'}
    </div>
  )}

  <div class="space-y-6">

    <!-- Product Cover -->
    <div
      class:list={[
        'relative overflow-hidden rounded-xl border p-4 flex min-h-56 items-center justify-center text-center',
        product.accentColor.bg,
        product.accentColor.border,
      ]}
    >
      {hasProductImage ? (
        <img
          src={product.coverImage}
          alt={`${product.title} cover`}
          class="h-full w-full max-h-64 object-contain rounded-lg"
          loading="lazy"
          decoding="async"
          itemprop="image"
        />
      ) : (
        <div class="flex flex-col items-center justify-center gap-4 py-8">

          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-white shadow-sm">
            <BookOpen
              class="h-7 w-7 text-[var(--color-apex-blue)]"
              aria-hidden="true"
            />
          </div>

          <div>
            <span class="text-[10px] font-mono font-bold tracking-widest uppercase text-[var(--color-text-gray)]">
              Premium Digital Asset
            </span>

            <h3 class="mt-1 text-lg font-bold text-[var(--color-dark-text)] leading-tight">
              {product.title}
            </h3>
          </div>

          <div class="text-[11px] font-semibold text-[var(--color-text-gray)] bg-white/80 px-2.5 py-0.5 rounded-full border border-[var(--color-border-gray)]">
            {siteConfig.name}
          </div>

        </div>
      )}
    </div>


    <!-- Badge & Price -->
    <div class="flex items-center justify-between gap-4 border-b border-[var(--color-border-gray)] pb-4">

      <span
        class:list={[
          'text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-md border',
          product.accentColor.bg,
          product.accentColor.text,
          product.accentColor.border,
        ]}
      >
        {product.badge}
      </span>

      <div
        class="text-right whitespace-nowrap"
        itemprop="offers"
        itemscope
        itemtype="https://schema.org/Offer"
      >

        {product.isBundle && product.bundleValue && (
          <span class="block text-xs font-semibold text-gray-400 line-through">
            {product.bundleValue}
          </span>
        )}

        <span
          class="text-xl font-extrabold text-[var(--color-dark-text)]"
          itemprop="price"
        >
          {product.price.display}
        </span>

        <meta
          itemprop="priceCurrency"
          content={product.price.currency}
        />

        <link
          itemprop="availability"
          href="https://schema.org/InStock"
        />

        {ctaUrl && (
          <link
            itemprop="url"
            href={ctaUrl}
          />
        )}

      </div>
    </div>


    <!-- Bundle Savings -->
    {product.isBundle &&
      product.bundleValue &&
      product.savings && (
        <div
          class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3"
          aria-label="Bundle savings"
        >
          <div class="flex flex-wrap items-center gap-2">

            <span class="font-semibold text-gray-500 line-through text-sm">
              Standalone value: {product.bundleValue}
            </span>

            <span class="font-bold text-emerald-700 text-sm">
              Save {product.savings}
            </span>

            {savingsPercent && (
              <span class="font-semibold text-emerald-700 text-sm">
                ({savingsPercent})
              </span>
            )}

          </div>

          <p class="mt-1 text-xs font-medium text-emerald-800">
            Get the complete
            {product.category === 'Welcome Email System'
              ? ' Welcome Email System'
              : ' Practical Resource Kit'}
            for less than buying each resource separately.
          </p>
        </div>
      )}


    <!-- Product Information -->
    <div>

      <h2
        class="text-xl font-bold text-[var(--color-dark-text)] leading-tight"
        itemprop="name"
      >
        {product.title}
      </h2>

      <p
        class="mt-2 text-sm font-medium text-[var(--color-apex-blue)] leading-relaxed"
      >
        {product.tagline}
      </p>

      <p
        class="mt-3 text-sm text-[var(--color-text-gray)] leading-relaxed"
        itemprop="description"
      >
        {product.description}
      </p>

    </div>


    <!-- Included Features -->
    <div class="space-y-3 pt-2">

      <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-dark-text)] block">
        What's Included:
      </span>

      <ul class="space-y-2">

        {product.features.map((feature) => (
          <li class="flex items-start gap-2 text-xs text-[var(--color-dark-text)]">

            <CheckCircle2
              class="h-4 w-4 text-[var(--color-growth-green)] shrink-0 mt-0.5"
              aria-hidden="true"
            />

            <span>{feature}</span>

          </li>
        ))}

      </ul>

    </div>

  </div>


  <!-- Purchase CTA -->
  <div class="pt-6 mt-6 border-t border-[var(--color-border-gray)]">

    {isAvailable ? (
      <a
        href={ctaUrl}
        class="gumroad-button flex h-12 w-full items-center justify-center gap-2 rounded-[var(--radius-btn)] font-semibold text-sm transition-all duration-200 bg-[var(--color-apex-blue)] text-white hover:bg-[var(--color-apex-blue-hover)]"
        aria-label={`${ctaLabel}: ${product.title}`}
      >

        <ShoppingBag
          class="h-4 w-4"
          aria-hidden="true"
        />

        <span>{ctaLabel}</span>

        <ExternalLink
          class="h-3.5 w-3.5"
          aria-hidden="true"
        />

      </a>
    ) : (
      <div class="flex h-12 w-full items-center justify-center rounded-[var(--radius-btn)] bg-[var(--color-soft-gray-bg)] text-[var(--color-text-gray)] border border-[var(--color-border-gray)] font-semibold text-sm">
        Coming Soon
      </div>
    )}

  </div>

</article>   
