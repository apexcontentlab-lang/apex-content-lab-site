---
import { siteConfig } from '../../config/site';
import { MessageCircle } from 'lucide-astro';
---

<a
  href={siteConfig.contact.whatsapp.fullUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-all duration-200 hover:scale-110 hover:shadow-xl focus-visible:outline-none"
  aria-label="Contact Apex Content Lab on WhatsApp"
  title="Chat with Growth Systems Strategist"
>
  <MessageCircle class="h-7 w-7 fill-white stroke-none" />
</a>
