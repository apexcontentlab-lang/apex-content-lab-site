---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Core Services | Apex Content Lab">
	<section style="text-align: center; margin-bottom: 3rem;">
		<h1 style="font-size: 2.25rem; color: #38bdf8; margin-bottom: 0.5rem;">Growth & Marketing Systems</h1>
		<p style="color: #94a3b8; font-size: 1.1rem; max-width: 650px; margin: 0 auto;">
			We build structured marketing systems that generate qualified leads, build customer relationships, and support sustainable business growth.
		</p>
	</section>

	<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
		<div style="background-color: #1e293b; padding: 1.5rem; border-radius: 0.75rem; border: 1px solid #334155;">
			<h2 style="color: #38bdf8; font-size: 1.3rem; margin-bottom: 0.75rem;">📩 Email Marketing Systems</h2>
			<p style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 1rem;">Build email systems that nurture leads, increase engagement, and convert subscribers into loyal customers.</p>
			<ul style="color: #f8fafc; font-size: 0.9rem; padding-left: 1.2rem; line-height: 1.8;">
				<li>Welcome Sequences & Newsletters</li>
				<li>Campaign Strategy & Copywriting</li>
				<li>Customer Retention Workflows</li>
			</ul>
		</div>

		<div style="background-color: #1e293b; padding: 1.5rem; border-radius: 0.75rem; border: 1px solid #334155;">
			<h2 style="color: #38bdf8; font-size: 1.3rem; margin-bottom: 0.75rem;">🎯 Lead Generation Systems</h2>
			<p style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 1rem;">Turn attention into qualified leads through strategic lead magnets and conversion-focused customer journeys.</p>
			<ul style="color: #f8fafc; font-size: 0.9rem; padding-left: 1.2rem; line-height: 1.8;">
				<li>Lead Magnet Strategy & Architecture</li>
				<li>Landing Pages & Capture Systems</li>
				<li>Audience Research & Conversion Strategy</li>
			</ul>
		</div>

		<div style="background-color: #1e293b; padding: 1.5rem; border-radius: 0.75rem; border: 1px solid #334155;">
			<h2 style="color: #38bdf8; font-size: 1.3rem; margin-bottom: 0.75rem;">⚙️ Marketing Automation</h2>
			<p style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 1rem;">Reduce manual work with automated customer journeys and scalable background workflows.</p>
			<ul style="color: #f8fafc; font-size: 0.9rem; padding-left: 1.2rem; line-height: 1.8;">
				<li>Automation Workflows & CRM Setup</li>
				<li>Behavioral Automation Triggers</li>
				<li>Email & Lead Sequences</li>
			</ul>
		</div>

		<div style="background-color: #1e293b; padding: 1.5rem; border-radius: 0.75rem; border: 1px solid #334155;">
			<h2 style="color: #38bdf8; font-size: 1.3rem; margin-bottom: 0.75rem;">📱 Content & Short-Form Video Strategy</h2>
			<p style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 1rem;">Create content that attracts the right audience while supporting your overall lead generation engine.</p>
			<ul style="color: #f8fafc; font-size: 0.9rem; padding-left: 1.2rem; line-height: 1.8;">
				<li>Reels, TikTok, & YouTube Shorts Strategy</li>
				<li>Content Repurposing & Calendars</li>
				<li>Programmatic Content Systems</li>
			</ul>
		</div>
	</div>

	<div style="text-align: center; margin-top: 3rem; background: #1e293b; padding: 2rem; border-radius: 0.75rem; border: 1px solid #334155;">
		<h2 style="color: #f8fafc; margin-bottom: 0.5rem;">Ready to Build Your Growth System?</h2>
		<p style="color: #94a3b8; margin-bottom: 1.5rem;">Let's build a marketing engine that continues working long after the post is published.</p>
		<a href="mailto:contact@apexcontentlab.com" class="btn">Inquire About Systems Setup</a>
	</div>
</Layout>
