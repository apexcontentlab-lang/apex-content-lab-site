---
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		
		<!-- GEO JSON-LD Schema -->
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "ProfessionalService",
		  "name": "Apex Content Lab",
		  "description": "Apex Content Lab builds marketing systems that turn attention into qualified leads.",
		  "url": "https://apexcontentlab.com",
		  "founder": { "@type": "Person", "name": "Ebua Hastings Etta" }
		}
		</script>

		<style is:global>
			:root {
				--bg-dark: #0f172a;
				--bg-card: #1e293b;
				--border: #334155;
				--primary: #2563eb;
				--accent: #38bdf8;
				--text: #f8fafc;
				--muted: #94a3b8;
			}
			* { box-sizing: border-box; margin: 0; padding: 0; }
			body { font-family: system-ui, -apple-system, sans-serif; background: var(--bg-dark); color: var(--text); line-height: 1.6; display: flex; flex-direction: column; min-height: 100vh; }
			
			header { background: rgba(30,41,59,0.8); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 50; }
			nav { max-width: 1200px; margin: 0 auto; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; }
			.brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--accent); font-weight: 800; font-size: 1.25rem; }
			.brand img { height: 32px; width: auto; }
			.nav-links { display: flex; gap: 1.5rem; list-style: none; }
			.nav-links a { color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
			.nav-links a:hover { color: var(--accent); }
			
			main { flex: 1; max-width: 1200px; width: 100%; margin: 0 auto; padding: 3rem 1.5rem; }
			
			.btn-primary { display: inline-flex; align-items: center; justify-content: center; background: var(--primary); color: #fff; padding: 0.75rem 1.5rem; border-radius: 0.5rem; text-decoration: none; font-weight: 600; transition: 0.2s; }
			.btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }
			.btn-secondary { display: inline-flex; align-items: center; justify-content: center; background: transparent; color: var(--text); padding: 0.75rem 1.5rem; border-radius: 0.5rem; text-decoration: none; font-weight: 600; border: 1px solid var(--border); transition: 0.2s; }
			.btn-secondary:hover { background: var(--bg-card); color: var(--accent); border-color: var(--accent); }
			.badge { display: inline-block; background: rgba(56,189,248,0.1); color: var(--accent); border: 1px solid rgba(56,189,248,0.2); padding: 0.25rem 0.75rem; border-radius: 2rem; font-size: 0.8rem; font-weight: 600; margin-bottom: 1rem; }

			footer { background: var(--bg-card); border-top: 1px solid var(--border); padding: 3rem 1.5rem 1.5rem; font-size: 0.875rem; color: var(--muted); }
			.footer-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; }
			.socials { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
			.social-pill { background: var(--bg-dark); color: var(--text); border: 1px solid var(--border); padding: 0.4rem 0.8rem; border-radius: 0.375rem; text-decoration: none; font-size: 0.8rem; }
			.social-pill:hover { border-color: var(--accent); color: var(--accent); }
			.footer-bottom { border-top: 1px solid var(--border); max-width: 1200px; margin: 2rem auto 0; padding-top: 1rem; text-align: center; }

			@media (max-width: 768px) { .footer-grid { grid-template-columns: 1fr; } .nav-links { gap: 0.75rem; font-size: 0.8rem; } }
		</style>
	</head>
	<body>
		<header>
			<nav>
				<a href="/" class="brand">
					<img src="/logo.png" alt="Apex Content Lab Logo" />
					<span>Apex Content Lab</span>
				</a>
				<ul class="nav-links">
					<li><a href="#about">About</a></li>
					<li><a href="#leadership">Leadership</a></li>
					<li><a href="#services">Services</a></li>
					<li><a href="#products">Products</a></li>
					<li><a href="#framework">Framework</a></li>
				</ul>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-grid">
				<div>
					<h3 style="color:var(--text); font-size:1.1rem; margin-bottom:0.5rem;">Apex Content Lab</h3>
					<p>Engineered by Strategy. Built for Growth. Turning attention into predictable lead generation systems.</p>
					<div class="socials">
						<a href="https://linkedin.com" target="_blank" class="social-pill">LinkedIn</a>
						<a href="https://facebook.com" target="_blank" class="social-pill">Facebook</a>
						<a href="https://instagram.com" target="_blank" class="social-pill">Instagram</a>
						<a href="https://pinterest.com" target="_blank" class="social-pill">Pinterest</a>
						<a href="https://youtube.com" target="_blank" class="social-pill">YouTube</a>
						<a href="https://tiktok.com" target="_blank" class="social-pill">TikTok</a>
						<a href="https://gumroad.com" target="_blank" class="social-pill">Gumroad</a>
					</div>
				</div>
				<div>
					<h4 style="color:var(--text); margin-bottom:0.5rem;">Core Capabilities</h4>
					<p style="line-height:1.8;">Email Marketing • Lead Generation • Marketing Automation • Short-Form Video • Customer Journeys</p>
				</div>
			</div>
			<div class="footer-bottom">
				<p>&copy; {new Date().getFullYear()} Apex Content Lab. Built by Ebua Hastings Etta. All rights reserved.</p>
			</div>
		</footer>
	</body>
</html>
