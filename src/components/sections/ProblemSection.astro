---
import { AlertTriangle, Flame, RefreshCw, XCircle } from 'lucide-astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const painPoints = [
  {
    icon: RefreshCw,
    title: "Starting From Scratch Daily",
    description: "Every new lead requires manually posting content, answering DMs, or launching new campaigns from zero."
  },
  {
    icon: Flame,
    title: "Chasing Algorithm Hype",
    description: "Wasting hours optimizing for vanity metrics, views, and temporary reach that fail to convert into owned subscribers."
  },
  {
    icon: XCircle,
    title: "The Leaky Bucket Dilemma",
    description: "Driving attention to social media profiles with no lead capture system, no email sequence, and zero automated follow-up."
  }
];
---

<section 
  id="problem"
  class={`relative bg-[var(--color-soft-gray-bg)] section-padding-lg border-b border-[var(--color-border-gray)] ${className}`}
  aria-label="The Problem with Traditional Marketing"
>
  <div class="container-apex">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-red-600">
        <AlertTriangle class="h-3.5 w-3.5" />
        <span>The Marketing Dilemma</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-bold tracking-tight text-[var(--color-dark-text)] leading-tight">
        Marketing Shouldn't Feel Like Starting From Zero Every Day.
      </h2>

      <p class="text-lg text-[var(--color-text-gray)] leading-relaxed">
        Many businesses work hard creating content every week. They post, they reply, they experiment. But without a structured marketing system, every sale depends on starting over.
      </p>
    </div>

    <!-- Main Section Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- LEFT COLUMN: Leaky Bucket Visual Diagram (5 Cols) -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-[440px] rounded-[var(--radius-card)] border border-[var(--color-border-gray)] bg-white p-6 shadow-[var(--shadow-apex-card)]">
          
          <div class="text-center pb-4 border-b border-[var(--color-border-gray)]">
            <span class="text-xs font-bold uppercase tracking-wider text-red-500">Traditional Agency Approach</span>
            <h3 class="text-lg font-bold text-[var(--color-dark-text)] mt-1">Unstructured Traffic Flow</h3>
          </div>

          <!-- Flow Diagram Container -->
          <div class="py-6 space-y-4">
            
            <!-- Input Traffic -->
            <div class="rounded-xl bg-blue-50 border border-blue-100 p-3 text-center">
              <span class="text-xs font-semibold text-[var(--color-apex-blue)] uppercase tracking-wider">Social Media Attention</span>
              <p class="text-xs text-[var(--color-text-gray)] mt-0.5">Reels, Posts, Ads, Random Reach</p>
            </div>

            <!-- Down Arrow -->
            <div class="flex justify-center text-[var(--color-text-gray)]">
              <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </div>

            <!-- The Leaky Bucket Container -->
            <div class="relative rounded-xl border-2 border-dashed border-red-300 bg-red-50/50 p-5 text-center space-y-3">
              <span class="text-sm font-bold text-red-600 block">No System Architecture</span>

              <!-- Leaks Visual -->
              <div class="space-y-2 text-left">
                <div class="flex items-center justify-between text-xs bg-white p-2 rounded border border-red-100 text-red-700">
                  <span class="font-bold">[Missing Lead Magnet]</span>
                  <span class="font-mono text-[10px] text-red-500">Leaked Traffic</span>
                </div>
                <div class="flex items-center justify-between text-xs bg-white p-2 rounded border border-red-100 text-red-700">
                  <span class="font-bold">[Missing Email Sequence]</span>
                  <span class="font-mono text-[10px] text-red-500">Lost Contacts</span>
                </div>
                <div class="flex items-center justify-between text-xs bg-white p-2 rounded border border-red-100 text-red-700">
                  <span class="font-bold">[Missing Automation]</span>
                  <span class="font-mono text-[10px] text-red-500">Zero Retention</span>
                </div>
              </div>
            </div>

            <!-- Result Box -->
            <div class="rounded-xl bg-gray-100 p-3 text-center border border-gray-200">
              <span class="text-xs font-bold text-[var(--color-dark-text)]">Result: Inconsistent Revenue</span>
            </div>

          </div>

          <div class="pt-4 border-t border-[var(--color-border-gray)] text-center">
            <span class="text-xs text-[var(--color-text-gray)] italic">"Content creates attention. Systems create growth."</span>
          </div>

        </div>
      </div>

      <!-- RIGHT COLUMN: Pain Points & Core Shift (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        {painPoints.map((point) => {
          const IconComponent = point.icon;
          return (
            <div class="flex items-start gap-4 p-5 rounded-[var(--radius-card)] border border-[var(--color-border-gray)] bg-white transition-all duration-200 hover:shadow-[var(--shadow-apex-card)]">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-50 text-red-600">
                <IconComponent class="h-6 w-6" />
              </div>
              <div class="space-y-1">
                <h3 class="text-xl font-bold text-[var(--color-dark-text)]">{point.title}</h3>
                <p class="text-base text-[var(--color-text-gray)] leading-relaxed">{point.description}</p>
              </div>
            </div>
          );
        })}

        <!-- Core Contrast Highlight Box -->
        <div class="rounded-[var(--radius-card)] bg-[var(--color-apex-blue)] p-6 text-white shadow-lg space-y-2 mt-8">
          <div class="text-xs font-bold uppercase tracking-wider text-[var(--color-growth-cyan)]">The Apex Philosophy</div>
          <p class="text-xl font-bold leading-snug">
            Businesses don't struggle because they lack content. Businesses struggle because they lack systems.
          </p>
          <p class="text-sm text-blue-100">
            Our job is to help you build the infrastructure that continues capturing and nurturing leads even when you're offline.
          </p>
        </div>

      </div>

    </div>

  </div>
</section>
