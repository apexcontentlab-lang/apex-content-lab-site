---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site';
import { servicesData, processSteps } from '../data/services';
import { faqsData } from '../data/faqs';

const homeFaqs = faqsData.slice(0, 6);
const growthStages = [
  ['ATTRACT', 'Reach the right audience with useful, relevant content and acquisition activity.'],
  ['CAPTURE', 'Give interested people a clear path from attention to an owned relationship.'],
  ['ONBOARD', 'Deliver the promised value and establish the next step immediately.'],
  ['NURTURE', 'Build trust and develop intent through relevant follow-up.'],
  ['SEGMENT', 'Use declared information and meaningful behavior to improve relevance.'],
  ['CONVERT', 'Create a clear path from qualified intent to conversation, purchase, or opportunity.'],
  ['OPTIMIZE', 'Measure the system, identify bottlenecks, and improve the highest-impact constraint.'],
];
---
<BaseLayout title={siteConfig.seo.defaultTitle} description={siteConfig.seo.defaultDescription} keywords={['Growth Systems Company','customer acquisition systems','lead generation systems','lead capture','lead nurture','content acquisition']}>
  <Header />
  <main id="main-content" class="flex-grow">
    <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/40 via-white to-white py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-4xl mx-auto space-y-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
            <span>Growth Systems Company</span><span class="text-blue-300">•</span><span>Customer Acquisition Infrastructure</span>
          </div>
          <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl leading-[1.15]">We Build the Systems Behind <span class="text-[var(--color-apex-blue,#2563EB)]">Customer Acquisition and Growth.</span></h1>
          <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">Apex Content Lab diagnoses where your customer journey is losing opportunities, then designs and implements the systems connecting attention, lead capture, follow-up, conversion, and measurement.</p>
          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href={siteConfig.routes.bookCall} class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-blue-700 focus-ring">Diagnose Your Growth System</a>
            <a href={siteConfig.routes.services} class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-8 py-4 text-base font-medium text-gray-700 hover:bg-gray-50 focus-ring">Explore Growth Systems</a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white border-y border-gray-100">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          <div class="space-y-5">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">The problem</span>
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">Attention is not the same thing as acquisition.</h2>
            <p class="text-gray-600 leading-relaxed">A business can publish consistently, generate traffic, gain followers, or run campaigns and still lose opportunities because there is no connected system behind the activity.</p>
            <p class="text-gray-600 leading-relaxed">When attention has nowhere to go, leads are not captured. When leads are captured without follow-up, intent goes cold. When conversion is disconnected from measurement, the business cannot see which part of the journey is actually constraining growth.</p>
          </div>
          <div class="rounded-3xl bg-gray-50 border border-gray-200 p-7 sm:p-8">
            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">The missing connection</p>
            <div class="mt-6 space-y-3">
              {['Attention','Capture','Nurture','Conversion'].map((stage, index) => (
                <div>
                  <div class={`rounded-xl border p-4 ${index === 3 ? 'bg-blue-50 border-blue-200' : 'bg-white border-gray-200'}`}>
                    <p class="font-bold text-gray-900">{stage}</p>
                    <p class="mt-1 text-xs text-gray-500">{['Creates demand and interest.','Turns interest into an owned relationship.','Develops trust and intent.','Turns qualified intent into a business outcome.'][index]}</p>
                  </div>
                  {index < 3 && <div class="text-center text-gray-300 font-bold py-1">↓</div>}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-gray-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">The Apex Growth System</span>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">A connected customer-acquisition journey.</h2>
          <p class="text-gray-600">The stages below describe the customer's growth system. Apex chooses interventions according to the actual bottleneck rather than forcing every business into the same build.</p>
        </div>
        <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {growthStages.map(([title, description], index) => (
            <article class="rounded-2xl bg-white border border-gray-200 p-6 shadow-sm">
              <span class="text-xs font-bold font-mono text-[var(--color-apex-blue,#2563EB)]">0{index + 1}</span>
              <h3 class="mt-3 text-lg font-bold text-gray-900">{title}</h3>
              <p class="mt-2 text-sm text-gray-600 leading-relaxed">{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">Growth Systems</span>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Services matched to the bottleneck.</h2>
          <p class="text-gray-600">Apex can intervene at one stage or connect multiple stages into an end-to-end acquisition system.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {servicesData.map((service) => (
            <article class={`rounded-2xl bg-white p-8 shadow-sm border ${service.isFlagship ? 'border-[var(--color-apex-blue,#2563EB)] ring-1 ring-blue-500/20' : 'border-gray-200'}`}>
              <span class={`inline-flex px-3 py-1 rounded-full text-xs font-semibold ${service.accentColor.bg} ${service.accentColor.text}`}>{service.badge}</span>
              <h3 class="mt-4 text-2xl font-bold text-gray-900">{service.title}</h3>
              <p class="mt-2 font-medium text-gray-800">{service.purpose}</p>
              <p class="mt-4 text-sm text-gray-600 leading-relaxed">{service.summary}</p>
              <a href={`/services/${service.slug}`} class="mt-7 inline-flex items-center justify-center w-full rounded-lg bg-gray-900 px-4 py-3 text-sm font-semibold text-white hover:bg-gray-800">Explore Service</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-gray-50 border-y border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">Apex Delivery Method</span>
          <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl">Diagnose first. Build what the evidence supports.</h2>
          <p class="text-gray-600">The customer journey is the reference point. Technology is selected after the system logic is understood.</p>
        </div>
        <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {processSteps.map((step) => (
            <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
              <span class="text-3xl font-extrabold text-[var(--color-apex-blue,#2563EB)] font-mono">{step.number}</span>
              <h3 class="mt-3 text-lg font-bold text-gray-900">{step.title}</h3>
              <p class="mt-2 text-sm text-gray-600 leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 text-center"><a href={siteConfig.routes.framework} class="text-sm font-semibold text-[var(--color-apex-blue,#2563EB)] hover:underline">Read the complete Apex methodology →</a></div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 space-y-3"><span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">Answers</span><h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Frequently asked questions</h2></div>
        <div class="space-y-7">
          {homeFaqs.map((faq) => <article class="border-b border-gray-200 pb-6"><h3 class="text-lg font-bold text-gray-900">{faq.question}</h3><p class="mt-2 text-sm text-gray-600 leading-relaxed">{faq.answer}</p></article>)}
        </div>
        <div class="mt-10 text-center"><a href="/faqs/growth-systems-faq" class="text-sm font-semibold text-[var(--color-apex-blue,#2563EB)] hover:underline">Read the complete Growth Systems FAQ →</a></div>
      </div>
    </section>

    <section class="py-20 bg-gray-900 text-white text-center">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-6">
        <span class="inline-flex rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold">Start with the problem, not the tool.</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold">Find the constraint. Build the system. Improve the outcome.</h2>
        <p class="text-gray-400">Apex Content Lab serves clients from Buea, Cameroon through remote engagements across Africa and other global markets.</p>
        <a href={siteConfig.routes.bookCall} class="inline-flex items-center justify-center rounded-xl bg-[var(--color-strategic-orange,#D97706)] px-8 py-4 text-base font-semibold text-white hover:bg-amber-700">Diagnose Your Growth System</a>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
