---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>

		<!-- GEO JSON-LD Structured Data -->
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "ProfessionalService",
		  "name": "Apex Content Lab",
		  "description": "Apex Content Lab helps businesses attract, capture, nurture, and convert customers through email marketing, lead generation, marketing automation, content strategy, and short-form video systems.",
		  "url": "https://apexcontentlab.com",
		  "founder": {
		    "@type": "Person",
		    "name": "Ebua Hastings Etta",
		    "jobTitle": "Founder & Marketing Systems Strategist"
		  },
		  "knowsAbout": [
		    "Email Marketing",
		    "Lead Generation Systems",
		    "Marketing Automation",
		    "Content Strategy",
		    "Short-Form Video Strategy",
		    "Customer Journey Design",
		    "Lead Nurturing",
		    "Email Funnels",
		    "CRM Automation",
		    "Conversion Strategy"
		  ]
		}
		</script>

		<style is:global>
			:root {
				--bg-dark: #0f172a;
				--bg-card: #1e293b;
				--border: #334155;
				--primary: #2563eb;
				--primary-hover: #1d4ed8;
				--accent: #38bdf8;
				--text: #f8fafc;
				--muted: #94a3b8;
			}
			* { box-sizing: border-box; margin: 0; padding: 0; }
			html { scroll-behavior: smooth; }
			body {
				font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
				background-color: var(--bg-dark);
				color: var(--text);
				line-height: 1.6;
				display: flex;
				flex-direction: column;
				min-height: 100vh;
			}
			
			header { background: rgba(30, 41, 59, 0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 50; }
			nav { max-width: 1200px; margin: 0 auto; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; }
			.brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--accent); font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; }
			.brand img { height: 36px; width: auto; object-fit: contain; }
			.nav-links { display: flex; gap: 1.5rem; list-style: none; align-items: center; }
			.nav-links a { color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s ease; }
			.nav-links a:hover { color: var(--accent); }
			
			main { flex: 1; max-width: 1200px; width: 100%; margin: 0 auto; padding: 3rem 1.5rem; }
			
			/* UI Controls */
			.btn-primary { display: inline-flex; align-items: center; justify-content: center; background: var(--primary); color: #fff; padding: 0.85rem 1.75rem; border-radius: 0.5rem; text-decoration: none; font-weight: 600; transition: all 0.2s ease; box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.39); }
			.btn-primary:hover { background: var(--primary-hover); transform: translateY(-1px); }
			.btn-secondary { display: inline-flex; align-items: center; justify-content: center; background: transparent; color: var(--text); padding: 0.85rem 1.75rem; border-radius: 0.5rem; text-decoration: none; font-weight: 600; border: 1px solid var(--border); transition: all 0.2s ease; }
			.btn-secondary:hover { background: var(--bg-card); color: var(--accent); border-color: var(--accent); }
			.badge { display: inline-block; background: rgba(56, 189, 248, 0.1); color: var(--accent); border: 1px solid rgba(56, 189, 248, 0.2); padding: 0.35rem 0.85rem; border-radius: 2rem; font-size: 0.85rem; font-weight: 600; margin-bottom: 1rem; }

			/* Footer Styling */
			footer { background: var(--bg-card); border-top: 1px solid var(--border); padding: 4rem 1.5rem 2rem; font-size: 0.9rem; color: var(--muted); }
			.footer-container { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr; gap: 3rem; }
			.footer-socials { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.5rem; }
			.social-pill { background: var(--bg-dark); color: var(--text); border: 1px solid var(--border); padding: 0.45rem 0.9rem; border-radius: 0.375rem; text-decoration: none; font-size: 0.85rem; transition: all 0.2s ease; }
			.social-pill:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }
			.footer-bottom { border-top: 1px solid var(--border); max-width: 1200px; margin: 3rem auto 0; padding-top: 1.5rem; text-align: center; font-size: 0.85rem; }

			@media (max-width: 768px) {
				.footer-container { grid-template-columns: 1fr; }
				.nav-links { gap: 0.85rem; font-size: 0.8rem; }
			}
		</style>
	</head>
	<body>
		<header>
			<nav>
				<a href="/" class="brand">
					<img src="/logo.png" alt="Apex Content Lab Logo" onerror="this.style.display='none'" />
					<span>Apex Content Lab</span>
				</a>
				<ul class="nav-links">
					<li><a href="#about">About</a></li>
					<li><a href="#founder">Founder</a></li>
					<li><a href="#services">Services</a></li>
					<li><a href="#products">Products</a></li>
					<li><a href="#framework">Framework</a></li>
				</ul>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-container">
				<div>
					<h3 style="color: var(--text); font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;">Apex Content Lab</h3>
					<p style="margin-bottom: 1rem; max-width: 500px;">Turn Attention Into Qualified Leads. Building marketing systems that scale small business growth naturally.</p>
					<div class="footer-socials">
						<a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-pill">LinkedIn</a>
						<a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="social-pill">Facebook</a>
						<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-pill">Instagram</a>
						<a href="https://pinterest.com" target="_blank" rel="noopener noreferrer" class="social-pill">Pinterest</a>
						<a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-pill">YouTube</a>
						<a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="social-pill">TikTok</a>
						<a href="https://apexlab1.gumroad.com" target="_blank" rel="noopener noreferrer" class="social-pill">Gumroad</a>
					</div>
				</div>
				<div>
					<h4 style="color: var(--text); font-weight: 600; margin-bottom: 0.75rem;">Core Capabilities</h4>
					<p style="line-height: 1.9;">
						Email Marketing • Lead Generation • Marketing Automation • Content Strategy • Short-Form Video Systems • Digital Marketing
					</p>
				</div>
			</div>
			<div class="footer-bottom">
				<p>&copy; {new Date().getFullYear()} Apex Content Lab. Built by Ebua Hastings Etta. All rights reserved.</p>
			</div>
		</footer>
	</body>
</html>
