---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site';

const frameworkStages = [
  {
    number: "01",
    title: "Attention & Content Engineering",
    badge: "Attract",
    description: "Systematic short-form video creation and topic modeling designed to capture target audience attention across Reels, TikTok, and YouTube Shorts without relying on vanity trends."
  },
  {
    number: "02",
    title: "Lead Capture & Value Assets",
    badge: "Capture",
    description: "High-converting, mobile-optimized landing pages and irresistible lead magnets engineered to convert passing views into owned email subscribers."
  },
  {
    number: "03",
    title: "Automated Onboarding & Delivery",
    badge: "Onboard",
    description: "Instant delivery of value assets paired with an automated 5-stage welcome email sequence that establishes immediate brand authority and sets customer expectations."
  },
  {
    number: "04",
    title: "Subscriber Nurture & Trust Building",
    badge: "Nurture",
    description: "Structured recurring newsletter frameworks and automated nurture workflows that deliver ongoing value and keep your brand top-of-mind."
  },
  {
    number: "05",
    title: "Segmentation & Intent Tracking",
    badge: "Segment",
    description: "Behavior-based subscriber tags and interest groups inside MailerLite that monitor subscriber interaction and signal high commercial intent."
  },
  {
    number: "06",
    title: "Conversion & Offer Positioning",
    badge: "Convert",
    description: "Targeted promotional email pushes, direct-response offers, and streamlined scheduling flows that seamlessly convert nurtured leads into paying clients."
  },
  {
    number: "07",
    title: "System Feedback & Optimization",
    badge: "Optimize",
    description: "Data collection across opt-in rates, click-throughs, and sales metrics to continuously refine content topics, landing page copy, and funnel performance."
  }
];
---

<BaseLayout
  title="The Apex Framework | Closed-Loop Growth Architecture"
  description="Explore the 7-stage closed-loop growth architecture engineered by Apex Content Lab to transform short-form online attention into owned email leads and predictable business growth."
>
  <Header />

  <main class="flex-grow">
    <!-- Header Hero -->
    <section class="bg-gradient-to-b from-blue-50/50 via-white to-white py-16 lg:py-24 border-b border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
            <span>The Closed-Loop Engine</span>
          </div>
          <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
            The 7-Stage Apex Framework
          </h1>
          <p class="text-lg text-gray-600 leading-relaxed">
            A permanent marketing infrastructure designed to systematically convert fragmented online attention into qualified email subscribers, nurtured relationships, and closed clients.
          </p>
        </div>
      </div>
    </section>

    <!-- Framework Stages List -->
    <section class="py-16 lg:py-24 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-12">
        {frameworkStages.map((stage) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm transition-all hover:border-blue-300 hover:shadow-md">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
              <div class="flex items-center gap-4">
                <span class="text-3xl font-black text-[var(--color-apex-blue,#2563EB)] font-mono">{stage.number}</span>
                <h2 class="text-2xl font-bold text-gray-900">{stage.title}</h2>
              </div>
              <span class="self-start sm:self-auto inline-block rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)] border border-blue-200">
                {stage.badge}
              </span>
            </div>
            <p class="text-base text-gray-600 leading-relaxed sm:pl-12">
              {stage.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom Call to Action -->
    <section class="py-16 bg-gray-900 text-white text-center">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-6">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Ready to Implement the Apex Framework?</h2>
        <p class="text-gray-400 text-base">
          Stop relying on temporary algorithms. Build a permanent marketing growth system tailored for your business.
        </p>
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={siteConfig.routes.bookCall}
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-8 py-3.5 text-base font-semibold text-white shadow-lg hover:bg-blue-700 transition-colors focus-ring"
          >
            Book Strategy Call
          </a>
          <a
            href={siteConfig.integrations.mailerlite.formPreviewUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl border border-gray-700 bg-gray-800 px-8 py-3.5 text-base font-medium text-white shadow-sm hover:bg-gray-700 transition-colors focus-ring"
          >
            Get Free Blueprint
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
