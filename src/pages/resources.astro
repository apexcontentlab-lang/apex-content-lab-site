---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { resourcesData } from '../data/resources';
---

<BaseLayout
  title="Free Resources & Growth Guides"
  description="Access free growth blueprints and practical marketing resources designed by Apex Content Lab."
>
  <Header />

  <main class="flex-grow">
    <!-- Header Hero -->
    <section class="bg-gradient-to-b from-blue-50/50 via-white to-white py-16 lg:py-24 border-b border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
            <span>Free Access Library</span>
          </div>

          <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
            Resource Library & Guides
          </h1>

          <p class="text-lg text-gray-600 leading-relaxed">
            Free blueprints and practical resources to help you build a stronger marketing growth system.
          </p>
        </div>
      </div>
    </section>

    <!-- Resources Grid -->
    <section class="py-16 lg:py-24 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

          {resourcesData.map((resource) => (
            <article
              id={resource.id}
              class:list={[
                'rounded-2xl border p-8 flex flex-col justify-between',
                resource.isFeatured
                  ? 'border-[var(--color-apex-blue,#2563EB)] bg-gradient-to-br from-blue-50/30 via-white to-white ring-1 ring-blue-500/20 shadow-md'
                  : 'border-gray-200 bg-white shadow-sm'
              ]}
            >

              <!-- Resource Cover -->
              {resource.coverImage && (
                <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-gray-50">
                  <img
                    src={resource.coverImage}
                    alt={`${resource.title} cover`}
                    class="h-64 w-full object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}

              <div class="space-y-4">
                <div class="flex items-center justify-between gap-2">
                  <span
                    class={`px-3 py-1 rounded-full text-xs font-semibold ${resource.badgeColor.bg} ${resource.badgeColor.text}`}
                  >
                    {resource.category}
                  </span>

                  <span class="text-xs text-gray-500 font-mono">
                    {resource.format} • {resource.readTime}
                  </span>
                </div>

                <h2 class="text-2xl font-bold text-gray-900">
                  {resource.title}
                </h2>

                <p class="text-sm text-gray-600 leading-relaxed">
                  {resource.description}
                </p>
              </div>

              <div class="pt-8">
                <a
                  href={resource.downloadUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex w-full items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-6 py-3.5 text-sm font-semibold text-white shadow-md hover:bg-blue-700 transition-colors focus-ring"
                >
                  Download Free Guide

                  <svg
                    class="ml-2 h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                    />
                  </svg>
                </a>
              </div>

            </article>
          ))}

        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
