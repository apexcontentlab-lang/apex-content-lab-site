---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site';

const lastUpdated = 'September 3, 2026';
---

<BaseLayout
  title={`Terms of Service | ${siteConfig.name}`}
  description={`Terms of Service for ${siteConfig.name}.`}
>
  <Header />

  <main id="main-content" class="flex-grow">
    <section class="bg-gradient-to-b from-blue-50/50 via-white to-white py-12 lg:py-16 border-b border-gray-100">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center space-y-3">
        <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
          Terms of Service
        </h1>
        <p class="text-xs font-mono text-gray-500">
          Last Updated: {lastUpdated}
        </p>
      </div>
    </section>

    <section class="py-12 lg:py-16 bg-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-8 text-sm text-gray-700 leading-relaxed">

        <div>
          <h2 class="text-lg font-bold text-gray-900">1. General</h2>
          <p class="mt-2">
            These Terms of Service govern your use of the Apex Content Lab website, resources, and services. By using the website or engaging Apex Content Lab for services, you agree to these terms and any applicable project-specific agreement or Statement of Work.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-gray-900">2. Services</h2>
          <p class="mt-2">
            Services are provided according to the scope, deliverables, timelines, responsibilities, and commercial terms agreed for each engagement. A proposal or Statement of Work may contain additional terms specific to a project.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-gray-900">3. Client Responsibilities</h2>
          <p class="mt-2">
            Clients are responsible for providing accurate information, required access, materials, approvals, and other inputs necessary for delivery. Client delays or missing dependencies may affect the agreed timeline.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-gray-900">4. Payments</h2>
          <p class="mt-2">
            Payment terms are defined in the applicable proposal, Statement of Work, invoice, or agreement. Apex Content Lab may delay or suspend work when required payments have not been received.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-gray-900">5. Intellectual Property</h2>
          <p class="mt-2">
            Ownership and permitted use of project deliverables, third-party materials, software, templates, frameworks, and other intellectual property are determined by the applicable project agreement or Statement of Work.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-gray-900">6. Third-Party Platforms</h2>
          <p class="mt-2">
            Projects may depend on third-party platforms and services. Apex Content Lab is not responsible for outages, pricing changes, feature changes, policy changes, limitations, or failures originating from third-party providers.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-gray-900">7. Results and Performance</h2>
          <p class="mt-2">
            Growth, marketing, conversion, and revenue outcomes depend on factors beyond Apex Content Lab's control. No specific business result is guaranteed unless expressly stated in a written agreement.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-gray-900">8. Changes to These Terms</h2>
          <p class="mt-2">
            These terms may be updated when our services, operating practices, or legal requirements change. The updated version will be published on this page with a revised date.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-gray-900">9. Contact</h2>
          <p class="mt-2">
            Questions about these terms can be directed to {siteConfig.contact.primaryEmail}.
          </p>
        </div>

      </div>
    </section>
  </main>

  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
