---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Free Blueprint | Apex Content Lab">
	<div style="max-width: 600px; margin: 0 auto; padding: 1rem 0;">
		<span style="background-color: rgba(56, 189, 248, 0.1); color: var(--accent); padding: 0.25rem 0.75rem; border-radius: 1rem; font-size: 0.875rem; font-weight: 600;">FREE RESOURCE</span>
		<h1 style="font-size: 2.25rem; margin: 0.75rem 0;">Attention to Leads Blueprint</h1>
		<p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 2rem;">
			Learn the step-by-step framework to plan, create, and schedule short-form content systematically without spending hours editing every single video.
		</p>

		<div class="card" style="background-color: var(--bg-card);">
			<h2 style="font-size: 1.25rem; margin-bottom: 1rem;">Get Instant Access</h2>
			<form style="display: flex; flex-direction: column; gap: 1rem;" onsubmit="event.preventDefault(); alert('Blueprint access link sent!');">
				<div>
					<label style="display: block; margin-bottom: 0.5rem; font-size: 0.9rem;" for="name">First Name</label>
					<input type="text" id="name" required placeholder="Enter your name" style="width: 100%; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #475569; background: #0f172a; color: white;" />
				</div>
				<div>
					<label style="display: block; margin-bottom: 0.5rem; font-size: 0.9rem;" for="email">Email Address</label>
					<input type="email" id="email" required placeholder="Enter your email" style="width: 100%; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #475569; background: #0f172a; color: white;" />
				</div>
				<button type="submit" class="btn" style="margin-top: 0.5rem;">Download Blueprint (PDF)</button>
			</form>
		</div>
	</div>
</Layout>
