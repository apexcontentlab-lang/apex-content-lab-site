---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home | Scalable Solutions">
	<section style="text-align: center; padding: 2rem 0;">
		<h1 style="font-size: 2.25rem; margin-bottom: 1rem; line-height: 1.2;">Automate & Scale Your Content Creation</h1>
		<p style="color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto 2rem Auto;">
			Discover programmatic workflows and templates designed to generate high-performing short-form video content efficiently.
		</p>
		<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
			<a href="/free-blueprint" class="btn">Get Free Blueprint</a>
			<a href="/products" class="btn" style="background-color: transparent; border: 1px solid #475569;">Explore Products</a>
		</div>
	</section>

	<section style="margin-top: 3rem;">
		<h2 style="text-align: center; margin-bottom: 1.5rem;">What We Offer</h2>
		<div class="card-grid">
			<div class="card">
				<h3>Content Automation</h3>
				<p style="color: var(--text-muted);">Learn how to leverage tools like Canva and AI platforms to generate bulk assets smoothly.</p>
			</div>
			<div class="card">
				<h3>Ready-Made Assets</h3>
				<p style="color: var(--text-muted);">Access scalable digital templates designed for high-engagement short-form video channels.</p>
			</div>
			<div class="card">
				<h3>Strategic Growth</h3>
				<p style="color: var(--text-muted);">Actionable blueprints to build, structure, and optimize your online digital assets.</p>
			</div>
		</div>
	</section>
</Layout>
