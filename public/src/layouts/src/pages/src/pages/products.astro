---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Products | Digital Assets">
	<h1 style="font-size: 2rem; margin-bottom: 0.5rem;">Digital Products</h1>
	<p style="color: var(--text-muted); margin-bottom: 2rem;">Pre-built templates and automation kits for creators and brands.</p>

	<div class="card-grid">
		<div class="card">
			<h3>Short-Form Video Automation Kit</h3>
			<p style="color: var(--text-muted); margin: 0.75rem 0 1.5rem 0;">A complete template bundle designed for batch-producing short videos quickly.</p>
			<a href="#" class="btn" style="width: 100%;">Learn More</a>
		</div>
		<div class="card">
			<h3>Canva Bulk Design Templates</h3>
			<p style="color: var(--text-muted); margin: 0.75rem 0 1.5rem 0;">Optimized multi-slide layouts tailored for Instagram Reels and TikTok formats.</p>
			<a href="#" class="btn" style="width: 100%;">Learn More</a>
		</div>
		<div class="card">
			<h3>Prompt & Asset Starter Pack</h3>
			<p style="color: var(--text-muted); margin: 0.75rem 0 1.5rem 0;">Curated prompt guide for consistent image and video creation using AI tools.</p>
			<a href="#" class="btn" style="width: 100%;">Learn More</a>
		</div>
	</div>
</Layout>
