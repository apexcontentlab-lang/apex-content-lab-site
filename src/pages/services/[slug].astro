---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import FloatingWhatsApp from '../../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../../config/site';
import { servicesData } from '../../data/services';
import { generateBreadcrumbSchema } from '../../schemas/masterSchema';

export function getStaticPaths() {
  return servicesData.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const pageTitle = service.title;
const pageDescription = `${service.summary} Learn what ${service.title} includes, who it is for, and how Apex Content Lab approaches implementation.`;
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', item: '/' },
  { name: 'Services', item: '/services' },
  { name: service.title, item: `/services/${service.slug}` },
]);
---
<BaseLayout title={pageTitle} description={pageDescription} keywords={[service.title, 'Apex Content Lab', 'growth systems', 'customer acquisition']}>
  <Header />
  <main id="main-content" class="flex-grow">
    <section class="bg-gradient-to-b from-blue-50/50 via-white to-white py-16 lg:py-24 border-b border-gray-100">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
        <span class={`inline-flex items-center rounded-full px-4 py-1.5 text-xs font-semibold ${service.accentColor.bg} ${service.accentColor.text}`}>{service.badge}</span>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">{service.title}</h1>
        <p class="mt-5 text-xl font-semibold text-gray-800">{service.purpose}</p>
        <p class="mt-4 max-w-3xl mx-auto text-lg text-gray-600 leading-relaxed">{service.summary}</p>
        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
          <a href={service.cta.href} class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-blue-700">{service.cta.text}</a>
          <a href="/services" class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-8 py-4 text-base font-semibold text-gray-700 hover:bg-gray-50">View All Services</a>
        </div>
      </div>
    </section>

    <section class="py-20 lg:py-24 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div class="lg:col-span-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">What is this service?</span>
            <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-gray-900">A system, not a disconnected deliverable.</h2>
            <p class="mt-5 text-base text-gray-600 leading-relaxed">Apex begins by understanding the business outcome and customer journey this service must support. The exact tools, assets, workflows, and implementation details are selected after diagnosis rather than imposed in advance.</p>
            <p class="mt-4 text-base text-gray-600 leading-relaxed">The result is an operational layer that can be measured, maintained, and connected to other stages of the customer's journey when appropriate.</p>
          </div>
          <aside class="rounded-2xl bg-gray-50 border border-gray-200 p-6 h-fit">
            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Growth stages</p>
            <div class="mt-4 flex flex-wrap gap-2">{service.growthStage.map((stage) => <span class="rounded-full bg-white border border-gray-200 px-3 py-1 text-xs font-semibold text-gray-700">{stage}</span>)}</div>
            {service.startingPrice && <p class="mt-6 text-sm text-gray-600"><strong>Starting point:</strong> {service.startingPrice}</p>}
          </aside>
        </div>
      </div>
    </section>

    <section class="py-20 lg:py-24 bg-gray-50 border-y border-gray-100">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">Scope</span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-gray-900">What the engagement can include</h2>
        </div>
        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
          {service.deliverables.map((item) => (
            <article class="rounded-2xl bg-white border border-gray-200 p-7 shadow-sm">
              <h3 class="text-lg font-bold text-gray-900">{item.title}</h3>
              <p class="mt-2 text-sm text-gray-600 leading-relaxed">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">Method</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">How Apex approaches {service.title}</h2>
          <p class="text-gray-600">The service plugs into the broader Apex delivery methodology: diagnose first, design the architecture, build only what the evidence supports, then test, launch, measure, and optimize.</p>
        </div>
        <div class="mt-10 flex flex-wrap justify-center gap-3">{['Diagnose','Strategize','Architect','Build','Connect','Automate','Train','Test','Launch','Measure','Optimize'].map((step) => <span class="rounded-full border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-semibold text-gray-700">{step}</span>)}</div>
      </div>
    </section>

    <section class="py-20 bg-gray-900 text-white text-center">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-5">
        <h2 class="text-3xl sm:text-4xl font-bold">Is {service.title} the right intervention?</h2>
        <p class="text-gray-400">We can diagnose the bottleneck before you commit to a build.</p>
        <a href={siteConfig.routes.bookCall} class="inline-flex items-center justify-center rounded-xl bg-[var(--color-strategic-orange,#D97706)] px-8 py-3.5 text-base font-semibold text-white hover:bg-amber-700">Diagnose Your Growth System</a>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingWhatsApp />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
