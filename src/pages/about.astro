---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site.ts';

const coreValues = [
  {
    title: "Assets Over Campaigns",
    description: "Campaigns expire. Growth infrastructure continues attracting, capturing, and converting leads 24/7."
  },
  {
    title: "Owned Audience First",
    description: "Social platforms rent reach; email lists guarantee ownership. We build systems that turn rented attention into owned list assets."
  },
  {
    title: "Frictionless Integration",
    description: "Simple, ultra-fast tech stacks (Astro, MailerLite, Vercel) outperform slow, complex legacy monoliths every time."
  },
  {
    title: "Data-Backed Precision",
    description: "No guesswork or vanity metrics. Every landing page and automated email workflow is optimized around direct ROI and conversion."
  }
];
---

<BaseLayout
  title={`About ${siteConfig.name} | Founder ${siteConfig.founder.name}`}
  description="Learn about Apex Content Lab, our core philosophy on permanent growth systems, and founder Ebua Hastings Etta."
>
  <Header />

  <main class="flex-grow">
    <!-- Header Hero -->
    <section class="bg-gradient-to-b from-blue-50/50 via-white to-white py-16 lg:py-24 border-b border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
            <span>Our Story & Philosophy</span>
          </div>
          <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
            Building Permanent Growth Infrastructure
          </h1>
          <p class="text-lg text-gray-600 leading-relaxed">
            Apex Content Lab exists to help modern businesses replace random marketing efforts with predictable, automated client acquisition engines.
          </p>
        </div>
      </div>
    </section>

    <!-- Company Philosophy -->
    <section class="py-16 lg:py-20 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="space-y-4">
            <h2 class="text-3xl font-bold text-gray-900">Why Apex Content Lab?</h2>
            <p class="text-sm text-gray-600 leading-relaxed">
              Most businesses fall into the social media treadmill: spending countless hours creating content only for the algorithm to dictate who sees it. When posting stops, revenue drops.
            </p>
            <p class="text-sm text-gray-600 leading-relaxed">
              We build closed-loop systems that bridge the gap between social media visibility and email marketing automation—turning casual content viewers into lifetime clients.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-4">
            {coreValues.map((value) => (
              <div class="p-5 rounded-2xl bg-gray-50 border border-gray-100">
                <h3 class="text-base font-bold text-gray-900 mb-1">{value.title}</h3>
                <p class="text-xs text-gray-600 leading-relaxed">{value.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Founder Section -->
<section id="founder" class="scroll-mt-28 py-16 lg:py-24 bg-gray-900 text-white">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="bg-gray-800 rounded-3xl p-8 sm:p-12 border border-gray-700">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">

        <div class="lg:col-span-8 space-y-4">
          <div class="inline-block px-3 py-1 rounded-full bg-blue-500/10 text-xs font-semibold text-blue-400 border border-blue-500/20">
            Founder Profile
          </div>

          <h2 class="text-3xl font-bold text-white">
            {siteConfig.founder.name}
          </h2>

          <p class="text-sm font-medium text-blue-400">
            {siteConfig.founder.role}
          </p>

          <p class="text-sm text-gray-300 leading-relaxed">
            As the founder of Apex Content Lab, Ebua Hastings Etta combines growth strategy, technical web architecture, and automated email workflows to help creators, consultants, and brands monetize attention systematically.
          </p>

          <div class="pt-4 flex items-center gap-4">
            <a
              href={siteConfig.routes.contact}
              class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-6 py-3 text-sm font-semibold text-white hover:bg-blue-700 transition-colors focus-ring"
            >
              Connect with Ebua
            </a>
          </div>
        </div>

        <!-- Founder Photo -->
        <div class="lg:col-span-4 flex justify-center">
          <div class="w-48 h-48 overflow-hidden rounded-2xl border-2 border-blue-500/30 bg-gray-700">
            <img
              src="/image/we/team/ebua-hastings-etta.png"
              alt="Ebua Hastings Etta, Founder of Apex Content Lab"
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
