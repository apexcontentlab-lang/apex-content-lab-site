---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Apex Content Lab | Programmatic Systems & Lead Engines">
	<section style="text-align: center; padding: 2rem 0;">
		<h1 style="font-size: 2.25rem; margin-bottom: 1rem; line-height: 1.2; color: #38bdf8;">
			Apex Content Lab
		</h1>
		<p style="color: #94a3b8; font-size: 1.1rem; max-width: 600px; margin: 0 auto 2rem auto;">
			Programmatic short-form video systems, high-converting Canva templates, and automated lead generation engines.
		</p>
		<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
			<a href="/free-blueprint" class="btn" style="background-color: #2563eb; color: white; padding: 0.75rem 1.5rem; border-radius: 0.5rem; text-decoration: none; font-weight: 600;">
				Get Free Attention to Leads Blueprint →
			</a>
			<a href="https://yourname.gumroad.com" class="btn" style="background-color: transparent; border: 1px solid #475569; color: white; padding: 0.75rem 1.5rem; border-radius: 0.5rem; text-decoration: none;">
				Browse Products
			</a>
		</div>
	</section>

	<section style="margin-top: 3rem;">
		<h2 style="text-align: center; margin-bottom: 1.5rem; color: #f8fafc;">Our Core Ecosystem</h2>
		<div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
			<div style="background-color: #1e293b; padding: 1.5rem; border-radius: 0.75rem; border: 1px solid #334155;">
				<h3 style="color: #38bdf8; margin-bottom: 0.5rem;">Attention to Leads Blueprint</h3>
				<p style="color: #94a3b8;">Our flagship free guide & sequence that transforms short-form video attention into high-value email subscribers.</p>
			</div>
			<div style="background-color: #1e293b; padding: 1.5rem; border-radius: 0.75rem; border: 1px solid #334155;">
				<h3 style="color: #38bdf8; margin-bottom: 0.5rem;">Lead Magnet Blueprint Kit</h3>
				<p style="color: #94a3b8;">Complete plug-and-play Canva production templates, high-converting copy scripts, and funnel structures.</p>
			</div>
		</div>
	</section>
</Layout>
