---
import { siteConfig } from '../../config/site';
import type { DigitalProduct } from '../../data/products';
import {
  CheckCircle2,
  ExternalLink,
  ShoppingBag,
  BookOpen,
} from 'lucide-astro';

interface Props {
  product: DigitalProduct;
  class?: string;
}

const { product, class: className = '' } = Astro.props;

const hasProductImage = Boolean(product.coverImage);

const ctaUrl =
  product.deliveryType === 'mailerlite'
    ? product.mailerliteUrl
    : product.gumroadUrl;

const isAvailable = Boolean(ctaUrl);

const ctaLabel =
  product.deliveryType === 'mailerlite'
    ? 'Get the Free Blueprint'
    : 'Get the Blueprint on Gumroad';
---

<article
  class:list={[
    'relative rounded-[var(--radius-card)] border bg-white p-8 flex flex-col justify-between transition-all duration-300 hover:shadow-[var(--shadow-apex-hover)] hover:-translate-y-1',
    product.isPopular
      ? 'border-2 border-[var(--color-apex-blue)] ring-4 ring-[var(--color-apex-blue-light)]'
      : 'border-[var(--color-border-gray)]',
    className,
  ]}
>
  {product.isPopular && (
    <div class="absolute -top-3.5 right-8 rounded-full bg-[var(--color-apex-blue)] px-4 py-1 text-xs font-bold text-white uppercase tracking-wider shadow-md">
      Most Popular
    </div>
  )}

  <div class="space-y-6">
    <!-- Product Cover -->
    <div
      class:list={[
        'relative overflow-hidden rounded-xl border p-4 flex min-h-56 items-center justify-center text-center',
        product.accentColor.bg,
        product.accentColor.border,
      ]}
    >
      {hasProductImage ? (
        <img
          src={product.coverImage}
          alt={`${product.title} cover`}
          class="h-full w-full max-h-64 object-contain rounded-lg"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="flex flex-col items-center justify-center gap-4 py-8">
          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-white shadow-sm">
            <BookOpen class="h-7 w-7 text-[var(--color-apex-blue)]" />
          </div>

          <div>
            <span class="text-[10px] font-mono font-bold tracking-widest uppercase text-[var(--color-text-gray)]">
              Digital Asset
            </span>

            <h3 class="mt-1 text-lg font-bold text-[var(--color-dark-text)] leading-tight">
              {product.title}
            </h3>
          </div>

          <div class="text-[11px] font-semibold text-[var(--color-text-gray)] bg-white/80 px-2.5 py-0.5 rounded-full border border-[var(--color-border-gray)]">
            {siteConfig.name}
          </div>
        </div>
      )}
    </div>

    <!-- Badge & Price -->
    <div class="flex items-center justify-between gap-4 border-b border-[var(--color-border-gray)] pb-4">
      <span
        class:list={[
          'text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-md border',
          product.accentColor.bg,
          product.accentColor.text,
          product.accentColor.border,
        ]}
      >
        {product.badge}
      </span>

      <span class="text-xl font-extrabold text-[var(--color-dark-text)] whitespace-nowrap">
        {product.price.display}
      </span>
    </div>

    <!-- Product Information -->
    <div>
      <h4 class="text-xl font-bold text-[var(--color-dark-text)] leading-tight">
        {product.title}
      </h4>

      <p class="mt-2 text-sm font-medium text-[var(--color-apex-blue)] leading-relaxed">
        {product.tagline}
      </p>

      <p class="mt-3 text-sm text-[var(--color-text-gray)] leading-relaxed">
        {product.description}
      </p>
    </div>

    <!-- Included Features -->
    <div class="space-y-3 pt-2">
      <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-dark-text)] block">
        What's Inside:
      </span>

      <ul class="space-y-2">
        {product.features.map((feature) => (
          <li class="flex items-start gap-2 text-xs text-[var(--color-dark-text)]">
            <CheckCircle2 class="h-4 w-4 text-[var(--color-growth-green)] shrink-0 mt-0.5" />
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Purchase / Download CTA -->
  <div class="pt-6 mt-6 border-t border-[var(--color-border-gray)]">
    {isAvailable ? (
      <a
        href={ctaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          'flex h-12 w-full items-center justify-center gap-2 rounded-[var(--radius-btn)] font-semibold text-sm transition-all duration-200',
          product.isPopular
            ? 'bg-[var(--color-strategic-orange)] text-white shadow-[var(--shadow-apex-cta)] hover:bg-[var(--color-strategic-orange-hover)]'
            : 'bg-[var(--color-apex-blue)] text-white hover:bg-[var(--color-apex-blue-hover)]',
        ]}
      >
        {product.deliveryType === 'mailerlite' ? (
          <BookOpen class="h-4 w-4" />
        ) : (
          <ShoppingBag class="h-4 w-4" />
        )}

        <span>{ctaLabel}</span>

        <ExternalLink class="h-3.5 w-3.5" />
      </a>
    ) : (
      <div class="flex h-12 w-full items-center justify-center rounded-[var(--radius-btn)] bg-[var(--color-soft-gray-bg)] text-[var(--color-text-gray)] border border-[var(--color-border-gray)] font-semibold text-sm">
        Coming Soon
      </div>
    )}
  </div>
</article>
