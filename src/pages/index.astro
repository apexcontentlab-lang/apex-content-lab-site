---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site';
import { servicesData, processSteps } from '../data/services';
import { productsData } from '../data/products';
import { testimonialsData } from '../data/testimonials';
import { faqsData } from '../data/faqs';
---

<BaseLayout 
  title={siteConfig.seo.defaultTitle}
  description={siteConfig.seo.defaultDescription}
>
  <Header />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/40 via-white to-white py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-4xl mx-auto space-y-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
            <span>Growth Systems Company</span>
            <span class="text-blue-300">•</span>
            <span>Permanent Marketing Infrastructure</span>
          </div>
          
          <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl leading-[1.15]">
            Turn Online Attention Into <span class="text-[var(--color-apex-blue,#2563EB)]">Predictable Business Growth</span>
          </h1>
          
          <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
            {siteConfig.description}
          </p>

          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={siteConfig.routes.bookCall}
              class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-blue-700 transition-colors focus-ring"
            >
              Book Strategy Call
            </a>
            <a
              href={siteConfig.integrations.mailerlite.formPreviewUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-8 py-4 text-base font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition-colors focus-ring"
            >
              Get Free Blueprint
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="py-20 bg-gray-50 border-y border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Our Growth Systems</h2>
          <p class="text-gray-600">Modular infrastructure engineered around your specific business objectives.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {servicesData.map((service) => (
            <div class={`rounded-2xl bg-white p-8 shadow-sm border ${service.isFlagship ? 'border-[var(--color-apex-blue,#2563EB)] ring-1 ring-blue-500/20' : 'border-gray-200'} flex flex-col justify-between`}>
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class={`px-3 py-1 rounded-full text-xs font-semibold ${service.accentColor.bg} ${service.accentColor.text}`}>
                    {service.badge}
                  </span>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-2">{service.title}</h3>
                <p class="text-gray-600 mb-6 text-sm leading-relaxed">{service.summary}</p>
                
                <ul class="space-y-2 mb-8 text-sm text-gray-700">
                  {service.keyFeatures.map((feature) => (
                    <li class="flex items-center gap-2">
                      <svg class="h-4 w-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href={service.cta.href}
                class="inline-flex items-center justify-center w-full rounded-lg bg-gray-900 px-4 py-3 text-sm font-semibold text-white hover:bg-gray-800 transition-colors"
              >
                {service.cta.text}
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process / Framework Section -->
    <section class="py-20 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">How We Build Systems</h2>
          <p class="text-gray-600">A structured 4-phase methodology for reliable client acquisition.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {processSteps.map((step) => (
            <div class="relative p-6 rounded-xl border border-gray-100 bg-gray-50/50">
              <span class="text-3xl font-extrabold text-[var(--color-apex-blue,#2563EB)] mb-4 block">{step.number}</span>
              <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="py-20 bg-gray-900 text-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Client Results</h2>
          <p class="text-gray-400">What happens when you deploy permanent marketing infrastructure.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {testimonialsData.map((item) => (
            <div class="rounded-2xl bg-gray-800 p-6 flex flex-col justify-between border border-gray-700">
              <div class="space-y-4">
                {item.metricHighlight && (
                  <div class="inline-block rounded-lg bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-400">
                    {item.metricHighlight.label}: {item.metricHighlight.value}
                  </div>
                )}
                <p class="text-gray-300 text-sm italic">"{item.quote}"</p>
              </div>
              <div class="mt-6 pt-4 border-t border-gray-700">
                <p class="font-bold text-sm text-white">{item.author.name}</p>
                <p class="text-xs text-gray-400">{item.author.role}, {item.author.company}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 space-y-3">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Frequently Asked Questions</h2>
        </div>

        <div class="space-y-6">
          {faqsData.map((faq) => (
            <div class="border-b border-gray-200 pb-6">
              <h3 class="text-lg font-bold text-gray-900 mb-2">{faq.question}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingWhatsApp />
</BaseLayout>

