---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import FloatingWhatsApp from '../../components/common/FloatingWhatsApp.astro';
import { siteConfig } from '../../config/site';
import { servicesData, diagnosticOffers, processSteps } from '../../data/services';

const pageTitle = 'Growth Systems & Services';
const pageDescription = 'Explore Apex Content Lab growth systems, diagnostics, optimization, consulting, and training for businesses that want a connected path from customer attention to measurable growth.';
---
<BaseLayout title={pageTitle} description={pageDescription} keywords={['growth systems company','customer acquisition systems','lead capture system','lead nurture system','content acquisition system','growth systems optimization']}>
  <Header />
  <main id="main-content" class="flex-grow">
    <section class="bg-gradient-to-b from-blue-50/50 via-white to-white py-16 lg:py-24 border-b border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center space-y-5">
          <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">Growth Systems Company</span>
          <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">Growth systems built around the customer journey.</h1>
          <p class="text-lg sm:text-xl text-gray-600 leading-relaxed">Apex diagnoses the constraint first, then designs and implements the system required to connect acquisition, capture, nurture, conversion, and measurement.</p>
          <div class="flex flex-col sm:flex-row justify-center gap-4 pt-3">
            <a href="#diagnostics" class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-7 py-3.5 text-sm font-semibold text-white shadow-lg hover:bg-blue-700">Start With a Diagnostic</a>
            <a href={siteConfig.routes.framework} class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-7 py-3.5 text-sm font-semibold text-gray-700 hover:bg-gray-50">See the Apex Framework</a>
          </div>
        </div>
      </div>
    </section>

    <section id="diagnostics" class="scroll-mt-24 py-20 lg:py-24 bg-gray-50 border-y border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">Diagnose before you build</span>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">Start with the right level of diagnosis.</h2>
          <p class="text-gray-600">Not every business needs a full systems rebuild. Apex uses the smallest appropriate diagnostic that can establish the problem, evidence, priority, and next intervention.</p>
        </div>
        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
          {diagnosticOffers.map((diagnostic) => (
            <article class="rounded-2xl bg-white border border-gray-200 p-7 shadow-sm">
              <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Diagnostic</p>
              <h3 class="mt-3 text-xl font-bold text-gray-900">{diagnostic.name}</h3>
              <p class="mt-3 text-2xl font-extrabold text-[var(--color-apex-blue,#2563EB)]">{diagnostic.price}</p>
              <p class="mt-3 text-sm text-gray-600 leading-relaxed">{diagnostic.description}</p>
              <a href={siteConfig.routes.bookCall} class="mt-6 inline-flex w-full items-center justify-center rounded-lg bg-gray-900 px-4 py-3 text-sm font-semibold text-white hover:bg-gray-800">Discuss the Diagnostic</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 lg:py-24 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">Build & Improve</span>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">Choose the system that matches the bottleneck.</h2>
          <p class="text-gray-600">Apex services are modular. A client can enter at one stage or build a connected acquisition system across multiple stages.</p>
        </div>
        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">
          {servicesData.map((service) => (
            <article id={service.id} class={`scroll-mt-24 rounded-2xl bg-white p-8 shadow-sm border ${service.isFlagship ? 'border-[var(--color-apex-blue,#2563EB)] ring-1 ring-blue-500/20' : 'border-gray-200'} flex flex-col justify-between`}>
              <div>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <span class={`px-3 py-1 rounded-full text-xs font-semibold ${service.accentColor.bg} ${service.accentColor.text}`}>{service.badge}</span>
                  {service.startingPrice && <span class="text-xs font-semibold text-gray-500">{service.startingPrice}</span>}
                </div>
                <h3 class="text-2xl font-bold text-gray-900">{service.title}</h3>
                <p class="mt-2 font-medium text-gray-800">{service.purpose}</p>
                <p class="mt-4 text-sm text-gray-600 leading-relaxed">{service.summary}</p>
                <ul class="mt-6 space-y-2 text-sm text-gray-700">
                  {service.keyFeatures.slice(0, 5).map((feature) => <li class="flex items-start gap-2"><span class="mt-1 text-emerald-600">✓</span><span>{feature}</span></li>)}
                </ul>
              </div>
              <a href={`/services/${service.slug}`} class="mt-8 inline-flex items-center justify-center w-full rounded-lg bg-gray-900 px-4 py-3 text-sm font-semibold text-white hover:bg-gray-800">Explore {service.title}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 lg:py-24 bg-gray-50 border-y border-gray-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">How Apex works</span>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">From diagnosis to continuous optimization.</h2>
        </div>
        <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {processSteps.map((step) => (
            <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
              <span class="text-3xl font-extrabold text-[var(--color-apex-blue,#2563EB)] font-mono">{step.number}</span>
              <h3 class="mt-3 text-lg font-bold text-gray-900">{step.title}</h3>
              <p class="mt-2 text-sm text-gray-600 leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-gray-900 text-white text-center">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-5">
        <h2 class="text-3xl sm:text-4xl font-bold">Not sure which system you need?</h2>
        <p class="text-gray-400">That is what diagnosis is for. Start with the business problem, not the tool or deliverable.</p>
        <a href={siteConfig.routes.bookCall} class="inline-flex items-center justify-center rounded-xl bg-[var(--color-strategic-orange,#D97706)] px-8 py-3.5 text-base font-semibold text-white shadow-lg hover:bg-amber-700">Diagnose Your Growth System</a>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingWhatsApp />
</BaseLayout>            
