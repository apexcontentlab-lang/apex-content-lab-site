---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services | Custom Consulting">
	<h1 style="font-size: 2rem; margin-bottom: 0.5rem;">Our Services</h1>
	<p style="color: var(--text-muted); margin-bottom: 2rem;">Tailored consulting and setup services to streamline your digital asset workflow.</p>

	<div class="card-grid">
		<div class="card">
			<h3>Workflow Audit</h3>
			<p style="color: var(--text-muted); margin: 0.75rem 0;">We review your content production pipeline and identify friction points and automation opportunities.</p>
		</div>
		<div class="card">
			<h3>Custom Template Creation</h3>
			<p style="color: var(--text-muted); margin: 0.75rem 0;">Bespoke Canva and video assets custom-aligned with your exact branding and output targets.</p>
		</div>
		<div class="card">
			<h3>Implementation Support</h3>
			<p style="color: var(--text-muted); margin: 0.75rem 0;">Direct setup guidance to connect your tools, platforms, and distribution channels seamlessly.</p>
		</div>
	</div>

	<div class="card" style="margin-top: 2.5rem; text-align: center; background-color: #0f2942; border-color: var(--primary);">
		<h2 style="margin-bottom: 0.5rem;">Need a Custom Setup?</h2>
		<p style="color: var(--text-muted); margin-bottom: 1.5rem;">Let us design a solution tailored specifically to your content goals.</p>
		<a href="mailto:contact@example.com" class="btn">Get in Touch</a>
	</div>
</Layout>
