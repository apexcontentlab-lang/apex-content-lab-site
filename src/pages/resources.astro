---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import { resourcesData } from '../data/resources';
---

<BaseLayout
  title="Free Attention-to-Leads Blueprint | Apex Content Lab"
  description="Get the free Attention-to-Leads Blueprint from Apex Content Lab and learn how to turn social media attention into captured leads, email relationships, and business opportunities."
>
  <Header />

  <main id="main-content" class="flex-grow">

    <!-- HERO -->
    <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/50 via-white to-white py-20 lg:py-28 border-b border-gray-100">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

        <div class="max-w-4xl mx-auto text-center space-y-6">

          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-[var(--color-apex-blue,#2563EB)]">
            <span>Free Growth Resource</span>
            <span class="text-blue-300">•</span>
            <span>Attention → Leads</span>
          </div>

          <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl leading-[1.1]">
            Turn attention into
            <span class="text-[var(--color-apex-blue,#2563EB)]">
              actual leads.
            </span>
          </h1>

          <p class="max-w-3xl mx-auto text-lg sm:text-xl text-gray-600 leading-relaxed">
            The free Attention-to-Leads Blueprint shows you how to connect content, lead capture, email nurture, and conversion into one practical customer journey.
          </p>

          <div class="pt-4 flex flex-wrap items-center justify-center gap-4">

            <a
              href="#blueprint"
              class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-blue-700 transition-colors"
            >
              Get the Free Blueprint
            </a>

            <a
              href="/framework"
              class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-8 py-4 text-base font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition-colors"
            >
              Explore the Framework
            </a>

          </div>

        </div>
      </div>
    </section>


    <!-- THE PROBLEM -->
    <section class="py-20 lg:py-24 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

          <div class="space-y-5">

            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
              The Problem
            </span>

            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
              Getting attention is not the same as generating leads.
            </h2>

            <p class="text-base text-gray-600 leading-relaxed">
              A business can receive views, likes, comments, followers, and profile visits without creating a reliable path for those people to become identifiable prospects.
            </p>

            <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
              The problem is often not the amount of attention. It is what happens after someone pays attention.
            </p>

            <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
              Without a clear next step, valuable attention disappears when the post disappears.
            </p>

          </div>


          <div class="rounded-3xl bg-gray-50 border border-gray-200 p-7 sm:p-8">

            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">
              The missing connection
            </p>

            <div class="mt-6 space-y-4">

              <div class="rounded-xl bg-white border border-gray-200 p-4">
                <p class="font-bold text-gray-900 text-sm">
                  Content
                </p>
                <p class="mt-1 text-xs text-gray-500">
                  Creates attention.
                </p>
              </div>

              <div class="text-center text-gray-300 font-bold">
                ↓
              </div>

              <div class="rounded-xl bg-white border border-gray-200 p-4">
                <p class="font-bold text-gray-900 text-sm">
                  Lead Capture
                </p>
                <p class="mt-1 text-xs text-gray-500">
                  Gives attention somewhere to go.
                </p>
              </div>

              <div class="text-center text-gray-300 font-bold">
                ↓
              </div>

              <div class="rounded-xl bg-white border border-gray-200 p-4">
                <p class="font-bold text-gray-900 text-sm">
                  Email Nurture
                </p>
                <p class="mt-1 text-xs text-gray-500">
                  Builds the relationship.
                </p>
              </div>

              <div class="text-center text-gray-300 font-bold">
                ↓
              </div>

              <div class="rounded-xl bg-blue-50 border border-blue-100 p-4">
                <p class="font-bold text-gray-900 text-sm">
                  Business Opportunity
                </p>
                <p class="mt-1 text-xs text-gray-600">
                  Creates a pathway toward a conversation, purchase, or conversion.
                </p>
              </div>

            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- BLUEPRINT -->
    <section id="blueprint" class="scroll-mt-24 py-20 lg:py-24 bg-gray-50 border-y border-gray-100">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

        <div class="text-center max-w-3xl mx-auto space-y-4">

          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
            Free Blueprint
          </span>

          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
            The Attention-to-Leads Blueprint
          </h2>

          <p class="text-base text-gray-600 leading-relaxed">
            A practical starting point for understanding how content and marketing activity can connect to a lead generation and nurture system.
          </p>

        </div>


        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">

          {resourcesData.map((resource) => (
            <article
              id={resource.id}
              class:list={[
                'rounded-3xl border p-7 sm:p-8 flex flex-col justify-between',
                resource.isFeatured
                  ? 'border-[var(--color-apex-blue,#2563EB)] bg-white ring-1 ring-blue-500/20 shadow-md'
                  : 'border-gray-200 bg-white shadow-sm'
              ]}
            >

              {resource.coverImage && (
                <div class="mb-7 overflow-hidden rounded-2xl border border-gray-200 bg-gray-50">
                  <img
                    src={resource.coverImage}
                    alt={`${resource.title} cover`}
                    class="h-64 w-full object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}

              <div class="space-y-5">

                <div class="flex items-center justify-between gap-3">

                  <span
                    class={`px-3 py-1 rounded-full text-xs font-semibold ${resource.badgeColor.bg} ${resource.badgeColor.text}`}
                  >
                    {resource.category}
                  </span>

                  <span class="text-xs text-gray-500 font-mono">
                    {resource.format} • {resource.readTime}
                  </span>

                </div>

                <h3 class="text-2xl font-bold text-gray-900">
                  {resource.title}
                </h3>

                <p class="text-sm text-gray-600 leading-relaxed">
                  {resource.description}
                </p>

              </div>

              <div class="pt-8 mt-8 border-t border-gray-100">

                <a
                  href={resource.downloadUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex w-full items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-6 py-3.5 text-sm font-semibold text-white shadow-md hover:bg-blue-700 transition-colors focus-ring"
                >
                  Download the Free Blueprint

                  <svg
                    class="ml-2 h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                    />
                  </svg>

                </a>

              </div>

            </article>
          ))}

        </div>

      </div>
    </section>


    <!-- WHAT YOU LEARN -->
    <section class="py-20 lg:py-24 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

        <div class="max-w-3xl mx-auto text-center space-y-4">

          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
            Inside the Blueprint
          </span>

          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
            What you'll understand after going through it.
          </h2>

          <p class="text-base text-gray-600 leading-relaxed">
            The Blueprint focuses on the connection between visibility, lead generation, and follow-up.
          </p>

        </div>


        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">

          <div class="rounded-2xl border border-gray-200 bg-gray-50 p-7">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400">
              01
            </span>

            <h3 class="mt-3 text-lg font-bold text-gray-900">
              Why attention alone is not enough
            </h3>

            <p class="mt-2 text-sm text-gray-600 leading-relaxed">
              Understand why views and followers need a clear next step if they are going to contribute to business growth.
            </p>
          </div>


          <div class="rounded-2xl border border-gray-200 bg-gray-50 p-7">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400">
              02
            </span>

            <h3 class="mt-3 text-lg font-bold text-gray-900">
              Where lead capture fits
            </h3>

            <p class="mt-2 text-sm text-gray-600 leading-relaxed">
              See how lead magnets, landing pages, forms, and other capture mechanisms give interested people a clear path forward.
            </p>
          </div>


          <div class="rounded-2xl border border-gray-200 bg-gray-50 p-7">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400">
              03
            </span>

            <h3 class="mt-3 text-lg font-bold text-gray-900">
              Why email matters
            </h3>

            <p class="mt-2 text-sm text-gray-600 leading-relaxed">
              Understand how email can create a more consistent relationship with people who have already shown interest.
            </p>
          </div>


          <div class="rounded-2xl border border-gray-200 bg-gray-50 p-7">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400">
              04
            </span>

            <h3 class="mt-3 text-lg font-bold text-gray-900">
              How the pieces connect
            </h3>

            <p class="mt-2 text-sm text-gray-600 leading-relaxed">
              See the customer journey as a connected system rather than a collection of unrelated marketing activities.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- WHO IT IS FOR -->
    <section class="py-20 lg:py-24 bg-gray-50 border-y border-gray-100">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

          <div class="space-y-5">

            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
              Who It's For
            </span>

            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
              Start here if your marketing creates attention but not enough identifiable leads.
            </h2>

            <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
              The Blueprint is especially useful for founders, consultants, service businesses, creators, and small teams that rely heavily on content or social media to attract potential customers.
            </p>

          </div>


          <div class="space-y-4">

            <div class="rounded-2xl bg-white border border-gray-200 p-6">
              <h3 class="font-bold text-gray-900">
                You are getting views but few leads.
              </h3>
            </div>

            <div class="rounded-2xl bg-white border border-gray-200 p-6">
              <h3 class="font-bold text-gray-900">
                You have followers but no reliable follow-up system.
              </h3>
            </div>

            <div class="rounded-2xl bg-white border border-gray-200 p-6">
              <h3 class="font-bold text-gray-900">
                Your content and email marketing feel disconnected.
              </h3>
            </div>

            <div class="rounded-2xl bg-white border border-gray-200 p-6">
              <h3 class="font-bold text-gray-900">
                You want a clearer path from attention to conversion.
              </h3>
            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- FAQ -->
    <section class="py-20 lg:py-24 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

        <div class="text-center max-w-3xl mx-auto space-y-4">

          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
            Blueprint FAQ
          </span>

          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
            Questions about the free Blueprint.
          </h2>

        </div>


        <div class="mt-12 space-y-4">

          <details class="group rounded-2xl border border-gray-200 bg-gray-50 p-6">

            <summary class="cursor-pointer list-none font-bold text-gray-900 flex items-center justify-between gap-4">

              <span>
                Is the Attention-to-Leads Blueprint really free?
              </span>

              <span class="text-gray-400 group-open:rotate-180 transition-transform">
                ↓
              </span>

            </summary>

            <p class="mt-4 text-sm text-gray-600 leading-relaxed">
              Yes. The Attention-to-Leads Blueprint is a free educational resource from Apex Content Lab designed to help businesses understand the basic path from content attention to lead generation and nurture.
            </p>

          </details>


          <details class="group rounded-2xl border border-gray-200 bg-gray-50 p-6">

            <summary class="cursor-pointer list-none font-bold text-gray-900 flex items-center justify-between gap-4">

              <span>
                Do I need an email marketing system to use it?
              </span>

              <span class="text-gray-400 group-open:rotate-180 transition-transform">
                ↓
              </span>

            </summary>

            <p class="mt-4 text-sm text-gray-600 leading-relaxed">
              No. The Blueprint is useful even if your email system is not built yet. It helps you understand where email and lead nurture fit before you start building the infrastructure.
            </p>

          </details>


          <details class="group rounded-2xl border border-gray-200 bg-gray-50 p-6">

            <summary class="cursor-pointer list-none font-bold text-gray-900 flex items-center justify-between gap-4">

              <span>
                Is this the same as the paid Lead Magnet Blueprint?
              </span>

              <span class="text-gray-400 group-open:rotate-180 transition-transform">
                ↓
              </span>

            </summary>

            <p class="mt-4 text-sm text-gray-600 leading-relaxed">
              No. The free Attention-to-Leads Blueprint introduces the broader customer journey. The paid Lead Magnet Blueprint focuses specifically on creating and structuring a lead magnet as part of a lead generation system.
            </p>

          </details>


          <details class="group rounded-2xl border border-gray-200 bg-gray-50 p-6">

            <summary class="cursor-pointer list-none font-bold text-gray-900 flex items-center justify-between gap-4">

              <span>
                What should I do after reading the Blueprint?
              </span>

              <span class="text-gray-400 group-open:rotate-180 transition-transform">
                ↓
              </span>

            </summary>

            <p class="mt-4 text-sm text-gray-600 leading-relaxed">
              Start by identifying the weakest part of your current journey: attention, lead capture, nurture, or conversion. From there, you can explore the Apex framework, premium resources, or implementation services depending on what you need.
            </p>

          </details>

        </div>

      </div>
    </section>


    <!-- INTERNAL LINK TO PAID PRODUCT -->
    <section class="py-20 lg:py-24 bg-gray-50 border-y border-gray-100">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

        <div class="rounded-3xl bg-gray-900 text-white p-8 sm:p-12 text-center">

          <span class="text-xs font-bold uppercase tracking-wider text-blue-400">
            Ready to Go Further?
          </span>

          <h2 class="mt-3 text-2xl sm:text-3xl font-bold">
            Build a better lead magnet.
          </h2>

          <p class="mt-4 max-w-2xl mx-auto text-sm sm:text-base text-gray-300 leading-relaxed">
            If the free Blueprint helped you see why lead capture matters, the premium Lead Magnet Blueprint takes the next step by focusing specifically on how to create a lead magnet that attracts the right prospects and fits into a wider growth system.
          </p>

          <div class="mt-7 flex flex-wrap justify-center gap-4">

            <a
              href="/products"
              class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-7 py-3.5 text-sm font-semibold text-white hover:bg-blue-700 transition-colors"
            >
              Explore Premium Resources
            </a>

            <a
              href="/framework"
              class="inline-flex items-center justify-center rounded-xl border border-gray-600 px-7 py-3.5 text-sm font-medium text-gray-200 hover:bg-gray-800 transition-colors"
            >
              Explore the Growth Framework
            </a>

          </div>

        </div>

      </div>
    </section>


     <!-- SERVICE CONNECTION -->
    <section class="py-20 lg:py-24 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">

        <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-apex-blue,#2563EB)]">
          Need Help Implementing It?
        </span>

        <h2 class="mt-3 text-2xl sm:text-3xl font-bold tracking-tight text-gray-900">
          Understanding the system is the first step.
        </h2>

        <p class="mt-4 max-w-2xl mx-auto text-sm sm:text-base text-gray-600 leading-relaxed">
          Apex Content Lab can also help build the lead generation, email marketing, and automation infrastructure behind the strategy.
        </p>

        <div class="mt-7 flex flex-wrap justify-center gap-4">

          <a
            href="/services/lead-capture-system"
            class="inline-flex items-center justify-center rounded-xl bg-[var(--color-apex-blue,#2563EB)] px-7 py-3.5 text-sm font-semibold text-white hover:bg-blue-700 transition-colors"
          >
            Lead Capture System
          </a>

          <a
            href="/services/lead-nurture-system"
            class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-7 py-3.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
          >
            Lead Nurture System
          </a>

        </div>

      </div>
    </section>

  </main>

  <Footer />
  <FloatingWhatsApp />
</BaseLayout>             
